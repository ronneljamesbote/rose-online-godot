+                    let Some(c) = conn.as_ref() else { continue };
+                    if let Some(target) = bridge.lock().unwrap().from_client.get(&target_entity_id.0).copied() {
+                        c.reducers.attack(target).ok();
+                    }
+                }
+                ClientMessage::Logout | ClientMessage::ReturnToCharacterSelect => {
+                    if let Some(c) = conn.take() {
