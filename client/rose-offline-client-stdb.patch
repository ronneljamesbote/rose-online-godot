+fn now_us() -> i64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap()
+        .as_micros() as i64
+}
+
+fn motion_position(m: &Motion, t_us: i64) -> (f32, f32) {
+    let (dx, dy) = (m.to_x - m.from_x, m.to_y - m.from_y);
+    let dist = (dx * dx + dy * dy).sqrt();
+    if dist < 0.01 || m.speed <= 0.0 {
+        return (m.to_x, m.to_y);
+    }
+    let f = (((t_us - m.started_at_us).max(0) as f32 / 1e6) * m.speed / dist).min(1.0);
+    (m.from_x + dx * f, m.from_y + dy * f)
+}
+
+fn motion_is_moving(m: &Motion, t_us: i64) -> bool {
+    let (x, y) = motion_position(m, t_us);
+    (x - m.to_x).abs() > 0.01 || (y - m.to_y).abs() > 0.01
+}
