+/// Spawn message for an entity, if all of its rows have arrived.
+fn spawn_message(db: &RemoteTables, bridge: &mut Bridge, id: u64) -> Option<ServerMessage> {
+    let entity = db.entity().entity_id().find(&id)?;
+    let motion = db.motion().entity_id().find(&id)?;
+    let combat = db.combat().entity_id().find(&id)?;
+    let t = now_us();
+    let (x, y) = motion_position(&motion, t);
+    let position = Vec3::new(x, y, 0.0);
+    let entity_id = bridge.client_id(id);
+    let spawn_command_state = if motion_is_moving(&motion, t) {
+        SpawnCommandState::Move {
+            target_position: Vec3::new(motion.to_x, motion.to_y, 0.0),
+            target_entity_id: motion.chase_target.map(|t| bridge.client_id(t)),
+        }
+    } else if combat.hp <= 0 {
+        SpawnCommandState::Die
+    } else {
+        SpawnCommandState::Stop
+    };
+    bridge.last_attack_target.insert(id, combat.attack_target);
+    match entity.kind {
+        EntityKind::Monster => Some(ServerMessage::SpawnEntityMonster {
+            entity_id,
+            npc: Npc::new(NpcId::new(entity.npc_id)?, 0),
+            position,
+            team: Team::default_monster(),
+            health: HealthPoints::new(combat.hp),
+            spawn_command_state,
+            move_mode: if motion.chase_target.is_some() { MoveMode::Run } else { MoveMode::Walk },
+            status_effects: Default::default(),
+        }),
+        EntityKind::Player => Some(ServerMessage::SpawnEntityCharacter {
+            data: Box::new(SpawnEntityCharacter {
+                character_info: test_character_info(&entity.name),
+                spawn_command_state,
+                entity_id,
+                equipment: test_equipment(false),
+                health: HealthPoints::new(combat.hp),
+                level: Level::new(10),
+                move_mode: MoveMode::Run,
+                move_speed: MoveSpeed::new(PLAYER_RUN_SPEED),
+                passive_attack_speed: 0,
+                position,
+                status_effects: Default::default(),
+                team: Team::default_character(),
+                personal_store_info: None,
+                clan_membership: None,
+            }),
+        }),
+    }
+}
+
+fn try_spawn(db: &RemoteTables, bridge: &mut Bridge, tx: &Sender<ServerMessage>, id: u64) {
+    if !bridge.joined || bridge.my_entity == Some(id) || bridge.spawned.get(&id).copied().unwrap_or(false) {
+        return;
+    }
+    if let Some(message) = spawn_message(db, bridge, id) {
+        bridge.spawned.insert(id, true);
+        tx.send(message).ok();
+    }
+}
+
+fn motion_message(bridge: &mut Bridge, motion: &Motion, is_monster: bool) -> ServerMessage {
+    let entity_id = bridge.client_id(motion.entity_id);
+    if motion_is_moving(motion, now_us()) {
+        ServerMessage::MoveEntity {
+            entity_id,
+            target_entity_id: motion.chase_target.map(|t| bridge.client_id(t)),
+            distance: 0,
+            x: motion.to_x,
+            y: motion.to_y,
+            z: 0,
+            move_mode: Some(if is_monster && motion.chase_target.is_none() { MoveMode::Walk } else { MoveMode::Run }),
+        }
+    } else {
+        ServerMessage::StopMoveEntity { entity_id, x: motion.to_x, y: motion.to_y, z: 0 }
+    }
+}
+
+fn register_callbacks(conn: &DbConnection, bridge: Arc<Mutex<Bridge>>, tx: Sender<ServerMessage>) {
+    use spacetimedb_sdk::__codegen::{WithDelete, WithInsert, WithUpdate};
+
+    {
+        let (bridge, tx) = (bridge.clone(), tx.clone());
+        WithInsert::on_insert(&conn.db.entity(), move |ctx, row| {
+            let mut b = bridge.lock().unwrap();
+            try_spawn(&ctx.db, &mut b, &tx, row.entity_id);
+        });
+    }
+    {
+        let (bridge, tx) = (bridge.clone(), tx.clone());
+        WithDelete::on_delete(&conn.db.entity(), move |_, row| {
+            let mut b = bridge.lock().unwrap();
+            if b.my_entity == Some(row.entity_id) {
+                return;
+            }
+            if let Some(cid) = b.release(row.entity_id) {
+                tx.send(ServerMessage::RemoveEntities { entity_ids: vec![cid] }).ok();
+            }
+        });
+    }
+    {
+        let (bridge, tx) = (bridge.clone(), tx.clone());
+        WithInsert::on_insert(&conn.db.motion(), move |ctx, row| {
+            let mut b = bridge.lock().unwrap();
+            try_spawn(&ctx.db, &mut b, &tx, row.entity_id);
+        });
+    }
+    {
+        let (bridge, tx) = (bridge.clone(), tx.clone());
+        WithInsert::on_insert(&conn.db.combat(), move |ctx, row| {
+            let mut b = bridge.lock().unwrap();
+            try_spawn(&ctx.db, &mut b, &tx, row.entity_id);
+        });
+    }
+    {
+        let (bridge, tx) = (bridge.clone(), tx.clone());
+        WithUpdate::on_update(&conn.db.motion(), move |ctx, old, new| {
+            let mut b = bridge.lock().unwrap();
+            if !b.joined || !(b.spawned.contains_key(&new.entity_id) || b.my_entity == Some(new.entity_id)) {
+                return;
+            }
+            let db = &ctx.db;
+            let is_monster = db.entity().entity_id().find(&new.entity_id).map_or(false, |e| e.kind == EntityKind::Monster);
+            // For our own player, chasing an attack target is driven by the client's Attack
+            // command (from AttackEntity). Echoing the server's chase path, or the stop when it
+            // arrives, would replace that command with a plain move and the swing would never play.
+            if b.my_entity == Some(new.entity_id) {
+                let attacking = db.combat().entity_id().find(&new.entity_id).map_or(false, |c| c.attack_target.is_some());
+                if new.chase_target.is_some() || old.chase_target.is_some() || attacking {
+                    return;
+                }
+            }
+            let message = motion_message(&mut b, new, is_monster);
+            tx.send(message).ok();
+        });
+    }
+    {
+        let (bridge, tx) = (bridge.clone(), tx.clone());
+        WithUpdate::on_update(&conn.db.combat(), move |ctx, old, new| {
+            let mut b = bridge.lock().unwrap();
+            if !b.joined {
+                return;
+            }
+            let db = &ctx.db;
+            let id = new.entity_id;
+            if b.my_entity == Some(id) {
+                // Revived: jump to the revive point.
+                if new.dead_until_us.is_none() && old.dead_until_us.is_some() {
+                    if let Some(m) = db.motion().entity_id().find(&id) {
+                        let entity_id = b.client_id(id);
+                        tx.send(ServerMessage::Teleport {
+                            entity_id,
+                            zone_id: ZoneId::new(ZONE_ID).unwrap(),
+                            x: m.to_x,
+                            y: m.to_y,
+                            run_mode: 1,
+                            ride_mode: 0,
+                        })
+                        .ok();
+                    }
+                    return;
+                }
+            }
+            if !(b.spawned.contains_key(&id) || b.my_entity == Some(id)) {
+                return;
+            }
+            let previous = b.last_attack_target.insert(id, new.attack_target).flatten();
+            if let Some(target) = new.attack_target {
+                if previous != Some(target) {
+                    if let Some(m) = db.motion().entity_id().find(&target) {
+                        let (x, y) = motion_position(&m, now_us());
+                        let entity_id = b.client_id(id);
+                        let target_entity_id = b.client_id(target);
+                        tx.send(ServerMessage::AttackEntity { entity_id, target_entity_id, distance: 0, x, y, z: 0 }).ok();
+                    }
+                }
+            }
+        });
+    }
+    {
+        let (bridge, tx) = (bridge.clone(), tx.clone());
+        WithInsert::on_insert(&conn.db.damage_event(), move |_, ev| {
+            let mut b = bridge.lock().unwrap();
+            if !b.joined || !b.to_client.contains_key(&ev.attacker) && b.my_entity != Some(ev.attacker) {
+                return;
+            }
+            let attacker_entity_id = b.client_id(ev.attacker);
+            let defender_entity_id = b.client_id(ev.defender);
+            tx.send(ServerMessage::DamageEntity {
+                attacker_entity_id,
+                defender_entity_id,
+                damage: Damage { amount: ev.amount as u32, is_critical: ev.is_critical, apply_hit_stun: false },
+                is_killed: ev.killed,
+                // The server sends damage at the swing's hit frame, so show it right away.
+                is_immediate: true,
+                from_skill: None,
+            })
+            .ok();
+        });
+    }
+}
+
+fn token_path() -> std::path::PathBuf {
+    let dir = directories::ProjectDirs::from("", "", "rose-offline-client")
+        .map(|d| d.data_local_dir().to_path_buf())
+        .unwrap_or_else(|| std::path::PathBuf::from("."));
+    dir.join("stdb_token")
+}
