+#[async_trait]
+impl ProtocolClient for StdbGameClient {
+    async fn run_connection(&mut self) -> Result<(), anyhow::Error> {
+        let tx = self.server_message_tx.clone();
+        let bridge = Arc::new(Mutex::new(Bridge::default()));
+        let conn: Option<DbConnection> = None;
+        let mut conn = conn;
+
+        while let Some(message) = self.client_message_rx.recv().await {
+            match message {
+                ClientMessage::ConnectionRequest { .. } | ClientMessage::GameConnectionRequest { .. } => {
+                    log::info!("stdb game client: connecting to {}", self.uri);
+                    let uri = self.uri.clone();
+                    let c = tokio::task::spawn_blocking(move || {
+                        // Keep the same SpacetimeDB identity across runs so the character persists.
+                        let token_path = token_path();
+                        DbConnection::builder()
+                            .with_uri(uri)
+                            .with_database_name("rose")
+                            .with_token(std::fs::read_to_string(&token_path).ok())
+                            .on_connect(move |_, _, token| {
+                                if let Some(dir) = token_path.parent() {
+                                    std::fs::create_dir_all(dir).ok();
+                                }
+                                std::fs::write(&token_path, token).ok();
+                            })
+                            .build()
+                    })
+                    .await??;
+                    log::info!("stdb game client: connected");
+                    register_callbacks(&c, bridge.clone(), tx.clone());
+                    c.subscription_builder().subscribe_to_all_tables();
+                    c.run_threaded();
+
+                    // Wait for our character's rows.
+                    let my_entity = loop {
+                        let id = c
+                            .try_identity()
+                            .and_then(|i| c.db.player().identity().find(&i))
+                            .and_then(|p| p.entity_id)
+                            .filter(|id| c.db.motion().entity_id().find(id).is_some() && c.db.combat().entity_id().find(id).is_some());
+                        if let Some(id) = id {
+                            break id;
+                        }
+                        tokio::time::sleep(std::time::Duration::from_millis(20)).await;
+                    };
+                    log::info!("stdb game client: own entity {}", my_entity);
+                    c.reducers.set_name(CHARACTER_NAME.to_string()).ok();
+                    c.reducers.set_loadout(ranged_from_env()).ok();
+                    bridge.lock().unwrap().my_entity = Some(my_entity);
+
+                    let motion = c.db.motion().entity_id().find(&my_entity).unwrap();
+                    let combat = c.db.combat().entity_id().find(&my_entity).unwrap();
+                    let (x, y) = motion_position(&motion, now_us());
+                    tx.send(ServerMessage::ConnectionRequestSuccess { packet_sequence_id: 0 }).ok();
+                    let equipment = test_equipment(ranged_from_env());
+                    tx.send(ServerMessage::CharacterData {
+                        data: Box::new(CharacterData {
+                            character_info: test_character_info(CHARACTER_NAME),
+                            position: Vec3::new(x, y, 0.0),
+                            zone_id: ZoneId::new(ZONE_ID).unwrap(),
+                            basic_stats: test_basic_stats(),
+                            level: Level::new(10),
+                            equipment: equipment.clone(),
+                            experience_points: ExperiencePoints::default(),
+                            skill_list: test_skill_list(),
+                            hotbar: Hotbar::default(),
+                            health_points: HealthPoints::new(combat.hp),
+                            mana_points: ManaPoints::new(100),
+                            stat_points: StatPoints::default(),
+                            skill_points: SkillPoints::default(),
+                            union_membership: UnionMembership::default(),
+                            stamina: Stamina::default(),
+                        }),
+                    })
+                    .ok();
+                    tx.send(ServerMessage::CharacterDataItems {
+                        data: Box::new(CharacterDataItems { inventory: Inventory::default(), equipment }),
+                    })
+                    .ok();
+                    tx.send(ServerMessage::CharacterDataQuest { quest_state: Box::new(QuestState::default()) }).ok();
+                    conn = Some(c);
+                }
+                ClientMessage::JoinZoneRequest => {
+                    let Some(c) = conn.as_ref() else { continue };
+                    let mut b = bridge.lock().unwrap();
+                    let me = b.my_entity.unwrap();
+                    let combat = c.db.combat().entity_id().find(&me).unwrap();
+                    let entity_id = b.client_id(me);
+                    // A re-join (after a revive teleport) re-sends everything.
+                    b.spawned.clear();
+                    b.joined = true;
+                    tx.send(ServerMessage::JoinZone {
+                        entity_id,
+                        experience_points: ExperiencePoints::default(),
+                        team: Team::default_character(),
+                        health_points: HealthPoints::new(combat.hp),
+                        mana_points: ManaPoints::new(100),
+                        world_ticks: WorldTicks(0),
+                        craft_rate: 0,
+                        world_price_rate: 100,
+                        item_price_rate: 100,
+                        town_price_rate: 100,
+                    })
+                    .ok();
+                    tx.send(ServerMessage::UpdateSpeed { entity_id, run_speed: PLAYER_RUN_SPEED as i32, passive_attack_speed: 0 }).ok();
+                    let ids: Vec<u64> = c.db.entity().iter().map(|e| e.entity_id).collect();
+                    for id in ids {
+                        try_spawn(&c.db, &mut b, &tx, id);
+                    }
+                }
+                ClientMessage::Move { target_entity_id, x, y, .. } => {
+                    log::info!("stdb game client: move {:?} {} {}", target_entity_id, x, y);
+                    let Some(c) = conn.as_ref() else { continue };
