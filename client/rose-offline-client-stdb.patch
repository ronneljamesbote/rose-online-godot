+#[derive(Default)]
+struct Bridge {
+    joined: bool,
+    my_entity: Option<u64>,
+    /// SpacetimeDB entity id -> client entity id. Client ids are small array indices.
+    to_client: HashMap<u64, ClientEntityId>,
+    from_client: HashMap<usize, u64>,
+    next_client_id: usize,
+    free_client_ids: Vec<usize>,
+    spawned: HashMap<u64, bool>,
+    last_attack_target: HashMap<u64, Option<u64>>,
+}
+
+impl Bridge {
+    fn client_id(&mut self, id: u64) -> ClientEntityId {
+        if let Some(cid) = self.to_client.get(&id) {
+            return *cid;
+        }
+        let raw = self.free_client_ids.pop().unwrap_or_else(|| {
+            self.next_client_id += 1;
+            self.next_client_id
+        });
+        let cid = ClientEntityId(raw);
+        self.to_client.insert(id, cid);
+        self.from_client.insert(raw, id);
+        cid
+    }
+
+    fn release(&mut self, id: u64) -> Option<ClientEntityId> {
+        let cid = self.to_client.remove(&id)?;
+        self.from_client.remove(&cid.0);
+        self.free_client_ids.push(cid.0);
+        self.spawned.remove(&id);
+        self.last_attack_target.remove(&id);
+        Some(cid)
+    }
+}
