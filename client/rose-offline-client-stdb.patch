@@ -0,0 +1,629 @@
+//! SpacetimeDB backend (rose-stdb module).
+//!
+//! The rest of the client keeps talking in `ClientMessage` / `ServerMessage`. The login
+//! and world steps are answered locally (there is one server, one channel and one test
+//! character); the game step connects to the SpacetimeDB module and turns its row
+//! updates into the `ServerMessage`s the game systems already understand.
+//!
+//! Select it with `--network-version spacetimedb --ip ws://127.0.0.1:3000`.
+
+#[allow(clippy::all, unused)]
+mod module_bindings;
+
+use std::{
+    collections::HashMap,
+    sync::{Arc, Mutex},
