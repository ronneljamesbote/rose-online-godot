+#[async_trait]
+impl ProtocolClient for StdbLoginClient {
+    async fn run_connection(&mut self) -> Result<(), anyhow::Error> {
+        while let Some(message) = self.client_message_rx.recv().await {
+            log::info!("stdb login client: {:?}", message);
+            let reply = match message {
+                ClientMessage::ConnectionRequest { .. } => {
+                    ServerMessage::ConnectionRequestSuccess { packet_sequence_id: 0 }
+                }
+                ClientMessage::LoginRequest { .. } => ServerMessage::LoginSuccess {
+                    server_list: vec![(0, "SpacetimeDB".into())],
+                },
+                ClientMessage::GetChannelList { server_id } => {
+                    // The client inserts its ServerList resource one frame after LoginSuccess,
+                    // so a ChannelList arriving in the same frame would be dropped.
+                    tokio::time::sleep(std::time::Duration::from_millis(250)).await;
+                    ServerMessage::ChannelList {
+                        server_id,
+                        channels: vec![(1, "Prototype".into())],
+                    }
+                }
+                ClientMessage::JoinServer { .. } => ServerMessage::JoinServerSuccess {
+                    login_token: 1,
+                    packet_codec_seed: 0,
+                    ip: "127.0.0.1".into(),
+                    port: 29100,
+                },
+                ClientMessage::Logout => return Err(ProtocolClientError::ClientInitiatedDisconnect.into()),
+                _ => continue,
+            };
+            self.server_message_tx.send(reply).ok();
+        }
+        Ok(())
+    }
+}
