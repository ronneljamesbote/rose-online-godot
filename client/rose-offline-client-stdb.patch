+
+/// Same events as `network_thread_system`, but login and world are answered locally and the
+/// game connection goes to the SpacetimeDB module at `config.server.ip` (a ws:// URI).
+pub fn stdb_network_thread_system(
+    mut commands: Commands,
+    network_thread: Res<NetworkThread>,
+    stdb: Res<crate::resources::StdbServer>,
+    mut network_events: EventReader<NetworkEvent>,
+) {
+    use crate::protocol::stdb::{StdbGameClient, StdbLoginClient, StdbWorldClient};
+    for event in network_events.iter() {
+        let (server_message_tx, server_message_rx) = crossbeam_channel::unbounded::<ServerMessage>();
+        let (client_message_tx, client_message_rx) =
+            tokio::sync::mpsc::unbounded_channel::<ClientMessage>();
+        match *event {
+            NetworkEvent::ConnectLogin { .. } => {
+                network_thread
+                    .control_tx
+                    .send(NetworkThreadMessage::RunProtocolClient(Box::new(StdbLoginClient::new(
+                        client_message_rx,
+                        server_message_tx,
+                    ))))
+                    .ok();
+                commands.insert_resource(LoginConnection::new(client_message_tx, server_message_rx));
+            }
+            NetworkEvent::ConnectWorld { login_token, ref password, .. } => {
+                network_thread
+                    .control_tx
+                    .send(NetworkThreadMessage::RunProtocolClient(Box::new(StdbWorldClient::new(
+                        client_message_rx,
+                        server_message_tx,
+                    ))))
+                    .ok();
+                commands.insert_resource(WorldConnection::new(
+                    client_message_tx,
+                    server_message_rx,
+                    login_token,
+                    Password::Plaintext(password.clone()),
+                ));
+            }
+            NetworkEvent::ConnectGame { login_token, ref password, .. } => {
+                network_thread
+                    .control_tx
+                    .send(NetworkThreadMessage::RunProtocolClient(Box::new(StdbGameClient::new(
+                        stdb.uri.clone(),
+                        client_message_rx,
+                        server_message_tx,
+                    ))))
+                    .ok();
+                commands.insert_resource(GameConnection::new(
+                    client_message_tx,
+                    server_message_rx,
+                    login_token,
+                    Password::Plaintext(password.clone()),
+                ));
+            }
+        }
+    }
+}
