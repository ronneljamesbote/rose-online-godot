[resource]
id = 2117
name = "On to Zant"
description = "Lutis told you your road goes on through the north-west gate of the Valley of Luxem Tower to Zant, the Canyon City. Find Lena, the guide, in Zant."
start_message = "Go through the north-west gate to Zant, the Canyon City, and find Lena the guide."
end_message = "Lena welcomed you to Zant."
