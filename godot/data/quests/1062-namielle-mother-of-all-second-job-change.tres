[resource]
id = 1062
name = "Namielle: Mother of All (Second Job Change)"
description = "During her adventures with the Seven Knights, Namielle invented many spells that were never passed down. However, the secrets to her legendary magic are supposedly hidden in the Old Priest Chain she lost during a battle with Junon's KingKong. Lisa has asked you to retrieve the Old Priest Chain from Junon's KingKong."
