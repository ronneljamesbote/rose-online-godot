[resource]
id = 1063
name = "Namielle: Mother of All (Second Job Change)"
description = "When a faction of the Seven Heroes was opposed to embarking on the Second Expedition, Namielle destroyed her own wedding ring with Lucid's Sword to illustrate her dedication and willingness to sacrifice. However, there is a rumor that her ring was never actually broken. To find out the truth, you should visit Mina, the jewel seller in Zant."
