id = 2104
name = "The Wagon That Never Came"
description = "One of Dorran's wagons never reached the camp. Find it in the dry wadi past the oasis and see if the driver is alive."
start_message = "Find Dorran's lost wagon in the dry wadi and talk to its driver."
end_message = "You told Dorran what happened to his wagon."
