[resource]
id = 2208
name = "Poisoned Seed"
description = "Rhys found the strangers' camp full of rotten seed. He wants 6 Rotten Seed Sacks back from the Choropies that carried them off."
start_message = "Bring Rhys 6 Rotten Seed Sacks from the Spotted and Mother Choropies round the camp."
end_message = "Rhys has seen enough: the seed was poisoned on purpose."
