[resource]
id = 2116
name = "The Broker's Trial"
description = "Harlan, the caravan's broker, will make you a Dealer if you can find goods and learn what they're worth. Bring 6 Plump Pumpkin Seeds, and ask Sella and Garro what they'd pay."
start_message = "Bring Harlan 6 Plump Pumpkin Seeds from the Big Pumpkins, and ask Sella and Garro in the camp what they'd pay."
end_message = "Harlan made you a Dealer."
