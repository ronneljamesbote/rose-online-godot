[resource]
id = 2403
name = "Safe Keeping"
description = "Crow of the Ferrell Guild keeps the storage. He gave you a pair of Scrap Gloves to put in your storage and take out again."
start_message = "Put the Scrap Gloves in Crow's storage and take them out, then talk to Crow again."
end_message = "Crow sent you to Tryteh for potions."
