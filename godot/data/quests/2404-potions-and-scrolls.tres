[resource]
id = 2404
name = "Potions and Scrolls"
description = "Tryteh the Arumic merchant gave you potions and a Zant Return Scroll. Put the potions on your hotbar; try them at the Training Grounds north of the walls if you like."
start_message = "Put the potions on your hotbar, then talk to Tryteh again."
end_message = "Tryteh sent you to Carrion next door."
