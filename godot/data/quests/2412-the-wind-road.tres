[resource]
id = 2412
name = "The Wind Road"
description = "Lena told you your road goes on east, through the Wind Road Caravan Camp by the east gate, into Breezy Hills. Find Caravan Master Odell at the camp."
start_message = "Find Caravan Master Odell at the Wind Road Caravan Camp by the east gate."
end_message = "Odell showed you the road to Breezy Hills."
