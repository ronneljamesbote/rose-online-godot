id = 2114
name = "The Sage's Trial"
description = "Orin, the oasis sage, will make you a Muse if you can find where the valley's mana gathers. Bring 6 Humming Pomic Dust from the Pomics."
start_message = "Bring Orin 6 Humming Pomic Dust from the Pomics and Needle Pomics."
end_message = "Orin made you a Muse."
