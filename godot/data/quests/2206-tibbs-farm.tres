[resource]
id = 2206
name = "Tibbs' Farm"
description = "Farmer Tibbs fled his farm on the terraces when the Flanae took root in it. He asked for 10 Farm Flanae Petals to show they can be beaten."
start_message = "Bring Tibbs 10 Farm Flanae Petals from the Flanae on the terraces west of Riverford."
end_message = "Tibbs dares to hope for his farm again."
