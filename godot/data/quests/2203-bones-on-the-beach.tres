[resource]
id = 2203
name = "Bones on the Beach"
description = "Wade asked you to walk up the shore to the old whale bones, where Old Tam combs the beach, and bring back proof that you went."
start_message = "Find Old Tam at the whale bones north along the beach."
end_message = "Wade has his proof."
