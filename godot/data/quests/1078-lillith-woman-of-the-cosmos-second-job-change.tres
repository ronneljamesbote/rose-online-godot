[resource]
id = 1078
name = "Lillith, Woman of the Cosmos (Second Job Change)"
description = "Jones expressed regret that Lillith's love story is more famous that her contributions to the Akram Kingdom. He suggested that you find Lillith's Scales in order to raise recognition of Lillith's true accomplishments. Go to the Gorge of Silence and investigate the Stone Golems that may be carrying Lillith's Scales."
