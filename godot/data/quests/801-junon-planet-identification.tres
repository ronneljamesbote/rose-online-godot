[resource]
id = 801
name = "Junon Planet Identification"
description = "You can get a job after reaching character Level 10. Bring your identification papers to the job mentors at the Sandwind Caravan Camp in the Valley of Luxem Tower: Sergeant Brakka for Soldiers, Sage Orin for Muses, Outrider Kesh for Hawkers and Broker Harlan for Dealers. "
