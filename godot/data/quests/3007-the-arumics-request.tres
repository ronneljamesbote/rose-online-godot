[resource]
id = 3007
name = "The Arumics' Request"
description = "In order to return to Luna, the Arumics have secretly been constructing a Flying Ship. As their ally, the Arumics have asked the Junon Order to help gather construction materials. Go to Kenji's Beach and hunt Krawfy so that you can bring them 20 Krawfy Hard Shells."
