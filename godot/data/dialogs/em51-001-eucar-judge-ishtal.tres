[sub_resource type="RoseDialogLine" id="RoseDialogLine_d85cx"]
text = "Yes, Luna appears peaceful, but there are some Arumics who refuse to recognize the shamanists. I intend to investigate shamanist history and prove that the shamanists have actually been living on Luna for a long time. In doing so, I hope those Arumics will reevaluate their opinions of the shamanists."
