[sub_resource type="RoseDialogLine" id="RoseDialogLine_vcvjb"]
text = "The main headquarters of the Arumics is located on Luna. The reason why magic became popular on the planet of Junon is because Arumics were dispatched from Luna to build a magic academy here and instruct the people of Junon on the mystic arts. Until now, we've been bringing important materials and skill books from the planet of Luna for magic users living in Junon."
