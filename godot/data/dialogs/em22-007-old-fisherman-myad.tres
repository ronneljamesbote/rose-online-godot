[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_0og0i"]
lines = Array[Resource]([SubResource("RoseDialogLine_gctgn"), SubResource("RoseDialogLine_l0t7p"), SubResource("RoseDialogLine_qmir6")])
resource_name = "Menu 35"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_esnpj"]
text = "Well, Junon Polis isn't able to support us all the way over here, and because I can treat simple injuries, people have been calling me a medic of the plains. {br} But lately, there's been some sort of weird epidemic going around. While I've been scrambling to find a cure, I've heard of a rumor that this disease may have originated from outside of here."
next_menu = 37
resource_name = "NPC: Well, Junon Polis isn't able to support us all t…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_8q14i"]
lines = Array[Resource]([SubResource("RoseDialogLine_esnpj")])
resource_name = "Menu 36"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_bjxnr"]
kind = "Answer"
text = "Hm… I see."
next_menu = 38
resource_name = "You: Hm… I see."

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_34ufl"]
lines = Array[Resource]([SubResource("RoseDialogLine_bjxnr")])
resource_name = "Menu 37"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_i5k1n"]
text = "Once you're infected, you start having fever symptoms, and dark spots appear all over your face. You lose all appetite and eventually, you just lose consciousness. I haven’t seen this kind of disease before, so I don’t even know what to do. We're facing an enormous danger. Would you please help us out?"
next_menu = 39
resource_name = "NPC: Once you're infected, you start having fever sym…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_nupdv"]
lines = Array[Resource]([SubResource("RoseDialogLine_i5k1n")])
resource_name = "Menu 38"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_bbc5l"]
kind = "Answer"
text = "Of course. It never hurts to help."
next_menu = 40
resource_name = "You: Of course. It never hurts to help."

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_yppiy"]
lines = Array[Resource]([SubResource("RoseDialogLine_bbc5l")])
resource_name = "Menu 39"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_jsbqa"]
text = "That’s great! I think {fc=1}Seyon{/fc} might know more about this. He's a merchant who's always traveling to Zant on business, so he may have caught word on something about the origin of this disease."
next_menu = 41
resource_name = "NPC: That’s great! I think {fc=1}Seyon{/fc} might kno…"

