resource_name = "Menu 20"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_ctred"]
kind = "Answer"
text = "Special traits?"
next_menu = 22
resource_name = "You: Special traits?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_rci3x"]
lines = Array[Resource]([SubResource("RoseDialogLine_ctred")])
resource_name = "Menu 21"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_tgdle"]
text = "Originally, Bardsrin, one of the Seven Knights, left the Zeppastone here. Although it looks like a normal gem, it has the power to summon powerful winds and storms. At first, our village was suffering from the horrible storms brought by the Zeppastone. Everyone feared Bardsrin and thought he was a demon!"
next_menu = 23
resource_name = "NPC: Originally, Bardsrin, one of the Seven Knights, …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_q8chb"]
lines = Array[Resource]([SubResource("RoseDialogLine_tgdle")])
resource_name = "Menu 22"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_xe50s"]
kind = "Answer"
text = "Hmm, that's interesting."
next_menu = 24
resource_name = "You: Hmm, that's interesting."

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_5sdlu"]
lines = Array[Resource]([SubResource("RoseDialogLine_xe50s")])
resource_name = "Menu 23"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_kdufr"]
text = "But one morning after a big storm, the weather suddenly grew very calm. The sky was clear and a gentle breeze was blowing. When the villagers went to check on the Zeppastone, they found that it was gone."
next_menu = 25
resource_name = "NPC: But one morning after a big storm, the weather s…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_ff8o3"]
