resource_name = "Menu 24"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_c7ven"]
kind = "Answer"
text = "Wait, I thought this Zeppastone is supposed to be your village's treasure!"
next_menu = 26
resource_name = "You: Wait, I thought this Zeppastone is supposed to b…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_qe5o2"]
lines = Array[Resource]([SubResource("RoseDialogLine_c7ven")])
resource_name = "Menu 25"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_o6jix"]
text = "Listen, I haven't finished! Mairath, the craftsman, found the Zeppastone while sweeping his chimney. That was how we learned that the stone emits the appropriate power when it's kept in a dark, enclosed place. What's also amazing is that it can move of its own accord to find places where it can properly work."
next_menu = 27
resource_name = "NPC: Listen, I haven't finished! Mairath, the craftsm…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_wlhjf"]
lines = Array[Resource]([SubResource("RoseDialogLine_o6jix")])
resource_name = "Menu 26"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_hg782"]
kind = "Answer"
text = "Amazing. So this Zeppastone sort of has a mind of its own."
next_menu = 28
resource_name = "You: Amazing. So this Zeppastone sort of has a mind o…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_k7tr4"]
lines = Array[Resource]([SubResource("RoseDialogLine_hg782")])
resource_name = "Menu 27"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_onwgp"]
text = "Now, since there haven't been any rumors about frightening storms on Junon, the Zeppastone must be in a dark, enclosed place right now."
next_menu = 29
resource_name = "NPC: Now, since there haven't been any rumors about f…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_gfowr"]
