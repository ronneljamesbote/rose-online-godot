resource_name = "You: Zeppastone?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_gg8mt"]
lines = Array[Resource]([SubResource("RoseDialogLine_vw65m")])
resource_name = "Menu 17"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_o5gs2"]
text = "Yes, the Windmill Village was once prosperous because of the strong winds in this area. Although this area is geographically ideal for wind, the Zeppastone was the source of the wind's power. But after the Mana Engine was invented, someone stole the Zeppastone and now the air in our village is still and lifeless."
next_menu = 19
resource_name = "NPC: Yes, the Windmill Village was once prosperous be…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_k1fg0"]
lines = Array[Resource]([SubResource("RoseDialogLine_o5gs2")])
resource_name = "Menu 18"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_qnvca"]
kind = "Answer"
text = "The Zeppastone could be anywhere on Junon! Any clue as to where I could find it?"
next_menu = 20
resource_name = "You: The Zeppastone could be anywhere on Junon! Any c…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_1j4fm"]
lines = Array[Resource]([SubResource("RoseDialogLine_qnvca")])
resource_name = "Menu 19"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_6jgn7"]
text = "If there were any clues about the Zeppastone's whereabouts, I'd search for it myself. Still, I can tell you about the Zeppastone's special traits."
next_menu = 21
resource_name = "NPC: If there were any clues about the Zeppastone's w…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_wjlea"]
