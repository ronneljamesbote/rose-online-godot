[sub_resource type="RoseDialogLine" id="RoseDialogLine_ghq4c"]
text = "As the Devil Pest spread throughout the world, and monsters grew more violent, the Seven Knights gathered for the first time. They could not eliminate all the monsters, but they were able to bring peace to the people, at least for a while."
