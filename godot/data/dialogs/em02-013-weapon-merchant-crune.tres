resource_name = "Menu 14"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_41tm6"]
text = "What? You haven't you heard about the legend of Hovert, the bravest Soldier ever? Hovert led the Solider troops when monsters first began to appear on the planet of Junon."
next_menu = 16
resource_name = "NPC: What? You haven't you heard about the legend of …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_aahkk"]
lines = Array[Resource]([SubResource("RoseDialogLine_41tm6")])
resource_name = "Menu 15"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_qqyom"]
kind = "Answer"
text = "If he's so famous, how come I haven't seen him before?"
next_menu = 17
resource_name = "You: If he's so famous, how come I haven't seen him b…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_vjj2r"]
lines = Array[Resource]([SubResource("RoseDialogLine_qqyom")])
resource_name = "Menu 16"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_fi3a2"]
text = "Hey, are you kidding me? It's been 30 years since Hovert died. Even if time has passed, Hovert has not been forgotten. In fact, people worship Hovert more and more because of a mystery he left behind."
next_menu = 18
resource_name = "NPC: Hey, are you kidding me? It's been 30 years sinc…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_xyw7y"]
lines = Array[Resource]([SubResource("RoseDialogLine_fi3a2")])
resource_name = "Menu 17"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_16xib"]
kind = "Answer"
text = "I don't understand. How can an unsolved mystery make Hovert look greater?"
next_menu = 19
resource_name = "You: I don't understand. How can an unsolved mystery …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_lamn7"]
lines = Array[Resource]([SubResource("RoseDialogLine_16xib")])
resource_name = "Menu 18"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_dgnx6"]
text = "Hovert died around Anima Lake. Luckily we found his body, but we couldn't find his mementos. So people guessed that Hovert predicted his death and hid his stuff someplace so it wouldn't be found."
next_menu = 20
resource_name = "NPC: Hovert died around Anima Lake. Luckily we found …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_ckrl5"]
lines = Array[Resource]([SubResource("RoseDialogLine_dgnx6")])
resource_name = "Menu 19"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_itik5"]
kind = "Answer"
text = "What makes his stuff so important? Wouldn't they just be worn out and rusty by now?"
next_menu = 21
resource_name = "You: What makes his stuff so important? Wouldn't they…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_0h178"]
lines = Array[Resource]([SubResource("RoseDialogLine_itik5")])
resource_name = "Menu 20"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_p3s7l"]
text = "That might be so for a normal Soldier, but this was Hovert. He was rumored to use a unique weapon and armor which he forged himself. If we could find them, they'd be a good contribution to the development of weapons and armors for Soldiers."
next_menu = 22
resource_name = "NPC: That might be so for a normal Soldier, but this …"

