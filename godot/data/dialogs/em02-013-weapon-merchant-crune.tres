[sub_resource type="RoseDialogLine" id="RoseDialogLine_61qai"]
text = "As he left with the other heroes on the expedition, Lucid gave the pieces of the sword to the head knight of the Righteous Crusaders. However, the Seven Knights never returned from their expedition, and no one knows what happened to the pieces of that sword. I suppose you can ask more about what happened from {fc=1}Leonard{/fc} in {fc=2}Zant{/fc}, since he is a descendant of that head knight."
