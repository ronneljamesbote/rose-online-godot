[sub_resource type="RoseDialogLine" id="RoseDialogLine_lag61"]
text = "People only remember Lucid as a ruler of the Akram Kingdom. But actually, he was king for only one year. In spite of this, he was Akram's greatest ruler, but his exploits as one of the Seven Knights are even more important."
