resource_name = "Menu 5"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_mmci8"]
text = "In Zant, you can trade items such as weapons, armors and other things with the merchants. You can also use your Storage and save your respawn point. You can also reset your character stats in Zant, but you'll need to meet some conditions and you can reset your stats only once."
next_menu = 7
resource_name = "NPC: In Zant, you can trade items such as weapons, ar…"

