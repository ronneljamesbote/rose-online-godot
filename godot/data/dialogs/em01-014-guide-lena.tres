[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_uh2fb"]
lines = Array[Resource]([SubResource("RoseDialogLine_1s0mr")])
resource_name = "Menu 41"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_lwpuo"]
text = "Actually, the dark energy has been coming from Luxem Tower in the {fc=2}Valley of Luxem Tower{/fc}, and has overflowed into {fc=2}Zant{/fc}. Can't you sense it?"
