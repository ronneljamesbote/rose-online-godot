[sub_resource type="RoseDialogLine" id="RoseDialogLine_cp0yv"]
text = "Various stores are located near the borders of Zant. The Storage keeper is located at the 11 o'clock direction of the town, and Francis, who saves your respawn point, is on a hill in the 7 o'clock direction. Oh, and if you want to find work, go visit the Tavern at the opposite side of the stream."
