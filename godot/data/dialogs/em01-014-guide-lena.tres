resource_name = "Menu 52"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_7mvmm"]
text = "You met with him? He probably mentioned me, so let's have it."
next_menu = 54
resource_name = "NPC: You met with him? He probably mentioned me, so l…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_m7ueu"]
lines = Array[Resource]([SubResource("RoseDialogLine_7mvmm")])
resource_name = "Menu 53"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_cjksj"]
kind = "Answer"
text = "Well, he mentioned your name and something about a {fc=14}Crystal Key{/fc}. I want to know more about this, so would you explain?"
next_menu = 55
resource_name = "You: Well, he mentioned your name and something about…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_nyutk"]
lines = Array[Resource]([SubResource("RoseDialogLine_cjksj")])
resource_name = "Menu 54"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_tw5e6"]
text = "Well, alright. I won't hide anything from you. But first, do you know what kind of person {fc=1}Luth{/fc} is?"
next_menu = 56
resource_name = "NPC: Well, alright. I won't hide anything from you. B…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_4ahc5"]
lines = Array[Resource]([SubResource("RoseDialogLine_tw5e6")])
resource_name = "Menu 55"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_obtfy"]
kind = "Answer"
text = "Yeah, he's a lively, curious kid. But because of that, he causes a lot of trouble."
next_menu = 57
resource_name = "You: Yeah, he's a lively, curious kid. But because of…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_o4irs"]
lines = Array[Resource]([SubResource("RoseDialogLine_obtfy")])
resource_name = "Menu 56"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_j18cl"]
text = "Exactly, he’s a trouble maker. Now, our ancestors created a huge hourglass in this village which contains the Soil of Purification. For many years, it's protected our village from dark spirits, as well as malice and crime."
next_menu = 58
resource_name = "NPC: Exactly, he’s a trouble maker. Now, our ancestor…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_7ybmg"]
lines = Array[Resource]([SubResource("RoseDialogLine_j18cl")])
resource_name = "Menu 57"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_kidf7"]
kind = "Answer"
text = "Hmm, I see."
next_menu = 59
resource_name = "You: Hmm, I see."

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_0dajo"]
lines = Array[Resource]([SubResource("RoseDialogLine_kidf7")])
resource_name = "Menu 58"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_tcd1d"]
text = "Now, when {fc=2}Luth{/fc} first came to our village, we quickly learned that he might cause trouble, and that someday he might mess around with the hourglass. To prevent that from happening, I explained the grave importance of the hourglass and why he should never touch it."
next_menu = 60
resource_name = "NPC: Now, when {fc=2}Luth{/fc} first came to our vill…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_ocgv4"]
lines = Array[Resource]([SubResource("RoseDialogLine_tcd1d")])
resource_name = "Menu 59"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_6g48t"]
kind = "Answer"
text = "Then, why did he touch the hourglass in the first place?"
next_menu = 61
resource_name = "You: Then, why did he touch the hourglass in the firs…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_52ogp"]
lines = Array[Resource]([SubResource("RoseDialogLine_6g48t")])
resource_name = "Menu 60"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_3o8vf"]
text = "That’s what I want to know. Although he may admit it was his mistake, this time he's made a really huge problem. The dark energy sealed in the hourglass has spread throughout our village, and people have begun to attack and steal from one another. I even lied and spread rumors to conceal this incident, but fortunately, you've awakened me."
next_menu = 62
resource_name = "NPC: That’s what I want to know. Although he may admi…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_ncfk4"]
lines = Array[Resource]([SubResource("RoseDialogLine_3o8vf")])
resource_name = "Menu 61"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_irmv6"]
kind = "Answer"
text = "So what are we supposed to do now?"
next_menu = 63
resource_name = "You: So what are we supposed to do now?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_kb1xh"]
lines = Array[Resource]([SubResource("RoseDialogLine_irmv6")])
resource_name = "Menu 62"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_x84ay"]
text = "Well, we've got to activate the hourglass. Now, just pushing the button isn't enough to purify all of the dark spirit that's spread around. For this special case, we'll need the {fc=14}Crystal Key{/fc}."
next_menu = 64
resource_name = "NPC: Well, we've got to activate the hourglass. Now, …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_8yja3"]
lines = Array[Resource]([SubResource("RoseDialogLine_x84ay")])
resource_name = "Menu 63"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_e28jh"]
kind = "Answer"
text = "Where can I get that {fc=14}Crystal Key{/fc}?"
next_menu = 65
resource_name = "You: Where can I get that {fc=14}Crystal Key{/fc}?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_q4lpb"]
lines = Array[Resource]([SubResource("RoseDialogLine_e28jh")])
resource_name = "Menu 64"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_grw3j"]
text = "It was always in the hourglass and no one has ever touched the Crystal Key. But since Luth caused this trouble, the Crystal Key also disappeared. I asked him where he put it, but he wouldn't answer. Would you ask {fc=1}Luth{/fc} where the {fc=14}Crystal Key{/fc} is again?"
next_menu = 66
resource_name = "NPC: It was always in the hourglass and no one has ev…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_e0xyt"]
lines = Array[Resource]([SubResource("RoseDialogLine_grw3j")])
resource_name = "Menu 65"

