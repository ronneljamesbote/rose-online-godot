[sub_resource type="RoseDialogLine" id="RoseDialogLine_3ij8g"]
text = "To the North of Zant is the El Verloon Desert, and to the South is the Valley of Luxem Tower. You can reach the Breezy Hills by going through the El Verloon Desert or through the Valley of Luxem Tower. I'll tell you more about places that are further away some other time."
next_menu = 5
resource_name = "NPC: To the North of Zant is the El Verloon Desert, a…"

