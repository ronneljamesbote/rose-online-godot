[sub_resource type="RoseDialogLine" id="RoseDialogLine_lvpr1"]
text = "I'd especially like to thank you for volunteering on our behalf. In gratitude, let me give you {fc=14}3 Resurrection Spellbooks{/fc}. {br}If you are defeated in battle, you will resurrect inside of the Forgotten Temple. However, once you run out of Resurrection Spellbooks, you will be sent outside of the temple and won't be able to come back inside."
