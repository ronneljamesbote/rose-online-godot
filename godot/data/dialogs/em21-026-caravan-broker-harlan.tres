[sub_resource type="RoseDialogLine" id="RoseDialogLine_fec041"]
text = "Anyone can swing a sword. A Dealer knows what everything is worth. The Big Pumpkins on the flats carry seeds that sell well in Zant. Bring me 6, and ask Sella and Garro what they'd pay for them. Learn the market, and I'll make you a Dealer."
next_menu = 4
resource_name = "NPC: Anyone can swing a sword. A Dealer knows what ev…"

