resource_name = "Menu 24"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_wmdup"]
text = "There are three different types of Stones of Nature: Water, Fire and Earth. They are commonly scattered in El Verloon Desert, but I hear it's easier to investigate {fc=12}Dalpings{/fc} and {fc=12}Ranger Dalpings{/fc}. People say they keep a lot of Stones of Nature with them. These Dalpings live Northeast of Breezy Hills. Would you go gather {fc=14}5 Stones of Nature of each attribute{/fc}?"
next_menu = 26
resource_name = "NPC: There are three different types of Stones of Nat…"

