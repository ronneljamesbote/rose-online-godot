resource_name = "Menu 21"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_3ogw5"]
kind = "Answer"
text = "So how would we strengthen the power of nature?"
next_menu = 23
resource_name = "You: So how would we strengthen the power of nature?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_tpnpv"]
lines = Array[Resource]([SubResource("RoseDialogLine_3ogw5")])
resource_name = "Menu 22"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_jye62"]
