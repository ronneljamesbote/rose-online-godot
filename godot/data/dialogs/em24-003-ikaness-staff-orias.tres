resource_name = "Menu 18"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_atclu"]
text = "You're right. We have detected a strange phenomenon a while ago that has suddenly decreased the power of nature. I'm afraid that Muses and all Mages will not be able to survive if this continues."
next_menu = 20
resource_name = "NPC: You're right. We have detected a strange phenome…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_lm4h1"]
