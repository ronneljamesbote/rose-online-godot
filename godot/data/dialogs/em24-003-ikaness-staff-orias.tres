resource_name = "Menu 19"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_eyle2"]
kind = "Answer"
text = "Then what should we do?"
next_menu = 21
resource_name = "You: Then what should we do?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_3drrt"]
lines = Array[Resource]([SubResource("RoseDialogLine_eyle2")])
resource_name = "Menu 20"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_qw8km"]
text = "There are two solutions. First, find and eliminate the cause of this strange phenomenon. Or, we could strengthen the power of nature to counteract the phenomenon's effects. Since we don't know its cause, we only have one choice: strengthen the power of nature."
next_menu = 22
resource_name = "NPC: There are two solutions. First, find and elimina…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_yyhdl"]
