lines = Array[Resource]([SubResource("RoseDialogLine_lbifc")])
resource_name = "Menu 94"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_w420e"]
text = "Have you ever heard about the leader of the Goblins?"
