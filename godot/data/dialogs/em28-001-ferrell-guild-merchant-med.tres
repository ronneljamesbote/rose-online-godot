resource_name = "Menu 92"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_hqfks"]
text = "In a very dark cave, at the bottom of an abyss, there is a small, green demon. {br}He is both leader of the Goblins, and subordinate to Hebarn. {br}Within these creatures, the 3 Scarlet Hearts of Hebarn are sealed. Until these seals are released, they will continue to guard the darkness. {br} The greatest of these holds the last heart, and possesses the Summon Stone that signifies him is indisputable leader of the Goblins."
next_menu = 94
resource_name = "NPC: In a very dark cave, at the bottom of an abyss, …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_422rk"]
lines = Array[Resource]([SubResource("RoseDialogLine_hqfks")])
resource_name = "Menu 93"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_lbifc"]
kind = "Answer"
text = "What kind of creatures are these notes talking about?"
next_menu = 95
resource_name = "You: What kind of creatures are these notes talking a…"

