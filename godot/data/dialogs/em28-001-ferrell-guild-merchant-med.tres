lines = Array[Resource]([SubResource("RoseDialogLine_myuhn")])
resource_name = "Menu 32"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_ianip"]
text = "The monster attacks happened at regular intervals. So we were able to schedule monster attacks, leave town beforehand and take refuge. If it weren't for that, we'd have been annihilated."
