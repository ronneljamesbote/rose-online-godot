resource_name = "Menu 98"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_swk2i"]
text = "Well, if you don't value life, you can go ahead and try it on your own. But this time, you've got to get 3 of Hebarn's Scarlet Hearts. Keep in mind that any creature that can command the Goblins is bound to be pretty dangerous."
next_menu = 100
resource_name = "NPC: Well, if you don't value life, you can go ahead …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_7b4nf"]
lines = Array[Resource]([SubResource("RoseDialogLine_swk2i")])
resource_name = "Menu 99"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_ydavg"]
kind = "Answer"
text = "I see. I guess it'll be necessary to form a party before investigating the Goblin Cave."
next_menu = 101
resource_name = "You: I see. I guess it'll be necessary to form a part…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_fosod"]
