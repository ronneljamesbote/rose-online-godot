resource_name = "Menu 110"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_75crg"]
text = "Ah, is that capsule looking thing the Summon Stone? It might be better if you held onto that. Anyway, while you were in the Goblin Cave, I found more of these Arumic researcher notes in the Tavern."
