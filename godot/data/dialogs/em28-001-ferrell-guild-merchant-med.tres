resource_name = "NPC: You'll have to find out for yourself. All I can …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_vl6rv"]
lines = Array[Resource]([SubResource("RoseDialogLine_abv1b")])
resource_name = "Menu 97"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_ds7yb"]
kind = "Answer"
text = "Is this something I need to do with the help of party members again?"
