resource_name = "You: Why did the monsters do that?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_4ti1v"]
lines = Array[Resource]([SubResource("RoseDialogLine_m0g70")])
resource_name = "Menu 30"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_eidnh"]
text = "I had no idea at first. I couldn't escape, and it was all I could do to hide so I wouldn't be killed like the others. Then one day, I noticed something strange."
