[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_upxup"]
lines = Array[Resource]([SubResource("RoseDialogLine_obqfq")])
resource_name = "Menu 34"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_gr18m"]
