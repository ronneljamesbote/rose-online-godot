lines = Array[Resource]([SubResource("RoseDialogLine_u2nb3")])
resource_name = "Menu 38"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_w1x61"]
text = "Now, those Arumic Researchers installed equipment all over this village. I don't know what they're called, but since they're supposed to accumulate Mana Energy, let's call them Mana Chargers. Now, a huge swarm of monsters used to invade the village, but as we removed Mana Chargers, fewer monsters would come to terrorize us. Do you see what I'm talking about?"
