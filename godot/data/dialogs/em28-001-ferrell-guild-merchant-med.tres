[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_y4cbf"]
lines = Array[Resource]([SubResource("RoseDialogLine_4ggbf")])
resource_name = "Menu 130"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_6p7sw"]
text = "I don't think I can even go to Junon Polis for a while, so please try to find Reffery in Luna for me. If he's even still alive, tell him about me. I'm very upset with those Arumic researchers for what they let happen to this village."
