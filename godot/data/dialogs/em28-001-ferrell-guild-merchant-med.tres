[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_vithx"]
lines = Array[Resource]([SubResource("RoseDialogLine_cdgdq")])
resource_name = "Menu 114"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_hn1uq"]
text = "Reffery, Arumic Researcher. {br}Should we be continuing this kind of horrific research? {br}I know what our work is doing to this town. I think we all knew it would happen. {br}But nobody talks about it. We can't because of them. {br}We can't even warn anyone in the village. If we do, our safety won't be guaranteed any longer."
next_menu = 116
resource_name = "NPC: Reffery, Arumic Researcher. {br}Should we be con…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_b8fqi"]
lines = Array[Resource]([SubResource("RoseDialogLine_hn1uq")])
resource_name = "Menu 115"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_7cvh2"]
kind = "Answer"
text = "Next page."
next_menu = 117
resource_name = "You: Next page."

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_p4bn0"]
lines = Array[Resource]([SubResource("RoseDialogLine_7cvh2")])
resource_name = "Menu 116"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_fqq7n"]
text = "In the Tavern, I met this kind and beautiful woman named Jude. I'm not going to let her die. But I still can't tell any of the villagers. {br}All 40 Mana Packs have been installed, but we'll also need the Hebarn's Hearts to remove that seal. {br}We need to collect an absurd amount of energy to release this seal. Once that happens, I don't know if even Luna will be safe. {br}Even so, once this research is done, I'm going to take Jude and we'll ride the Flying Ship to Luna. {br}Whoever may be reading this might think of me as despicable for not stopping this, but..."
next_menu = 118
resource_name = "NPC: In the Tavern, I met this kind and beautiful wom…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_mdcha"]
lines = Array[Resource]([SubResource("RoseDialogLine_fqq7n")])
resource_name = "Menu 117"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_jnnqn"]
kind = "Answer"
text = "This is the last page."
