lines = Array[Resource]([SubResource("RoseDialogLine_w420e")])
resource_name = "Menu 95"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_8yurk"]
kind = "Answer"
text = "Leader of the Goblins? I should be able to find them in the Goblin Cave, right?"
