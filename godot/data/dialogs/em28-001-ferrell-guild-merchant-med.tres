lines = Array[Resource]([SubResource("RoseDialogLine_6uldd")])
resource_name = "Menu 112"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_pdx5r"]
text = "Well, the writing is too small, so I can't read any of it. Why don't you try?"
