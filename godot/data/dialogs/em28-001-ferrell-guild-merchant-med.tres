[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_73iag"]
lines = Array[Resource]([SubResource("RoseDialogLine_npx4i")])
resource_name = "Menu 123"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_j4ycl"]
kind = "Answer"
text = "Well, those researchers didn't really want to install those Mana Chargers. I guess all they could do was leave hints on the Chargers and these notes."
next_menu = 125
resource_name = "You: Well, those researchers didn't really want to in…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_huiwk"]
lines = Array[Resource]([SubResource("RoseDialogLine_j4ycl")])
resource_name = "Menu 124"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_0vu0k"]
text = "So he ran away to Luna with that Jude. He must be enjoying himself."
