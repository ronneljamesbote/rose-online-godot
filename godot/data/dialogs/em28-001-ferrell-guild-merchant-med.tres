resource_name = "Menu 17"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_rn5r4"]
kind = "Answer"
text = "Who do you mean by 'them'? I've come to find you as a favor for Bith."
next_menu = 19
resource_name = "You: Who do you mean by 'them'? I've come to find you…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_xb1on"]
lines = Array[Resource]([SubResource("RoseDialogLine_rn5r4")])
resource_name = "Menu 18"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_wxbgx"]
text = "*Phew* Alright, you just seemed suspicious. But right now, I don't have the luxury to worry about Bith."
next_menu = 20
resource_name = "NPC: *Phew* Alright, you just seemed suspicious. But …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_5b5r7"]
lines = Array[Resource]([SubResource("RoseDialogLine_wxbgx")])
resource_name = "Menu 19"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_hjdmd"]
kind = "Answer"
text = "Hey, won't you tell me more?"
next_menu = 21
resource_name = "You: Hey, won't you tell me more?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_v21qd"]
lines = Array[Resource]([SubResource("RoseDialogLine_hjdmd")])
resource_name = "Menu 20"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_2fmf8"]
text = "Heh heh. Fine. You don't have much time either, so I'll tell you. Besides, if I don't share this information, the truth would be concealed forever. Still, you might not believe what I tell you."
next_menu = 22
resource_name = "NPC: Heh heh. Fine. You don't have much time either, …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_24amk"]
lines = Array[Resource]([SubResource("RoseDialogLine_2fmf8")])
resource_name = "Menu 21"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_s88f2"]
kind = "Answer"
text = "Well. I'm listening."
next_menu = 23
resource_name = "You: Well. I'm listening."

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_26apa"]
lines = Array[Resource]([SubResource("RoseDialogLine_s88f2")])
resource_name = "Menu 22"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_ilwiu"]
text = "So several weeks ago? Or was it months? It doesn't matter. A group of white garbed people came here, installed some strange objects, and then disappeared. Later, I found that they were probably Arumic researchers."
next_menu = 24
resource_name = "NPC: So several weeks ago? Or was it months? It doesn…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_pyt6x"]
lines = Array[Resource]([SubResource("RoseDialogLine_ilwiu")])
resource_name = "Menu 23"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_hq2c2"]
kind = "Answer"
text = "And then…?"
next_menu = 25
resource_name = "You: And then…?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_1i1sd"]
lines = Array[Resource]([SubResource("RoseDialogLine_hq2c2")])
resource_name = "Menu 24"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_xrr1x"]
text = "They told me they detected a strange Mana Energy and wanted to accumulate it with these chargers they just installed. I didn't know what they were talking about, so I let them do what they wanted."
next_menu = 26
resource_name = "NPC: They told me they detected a strange Mana Energy…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_qkr1y"]
lines = Array[Resource]([SubResource("RoseDialogLine_xrr1x")])
resource_name = "Menu 25"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_r86o2"]
kind = "Answer"
text = "I see. "
next_menu = 27
resource_name = "You: I see."

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_qilco"]
lines = Array[Resource]([SubResource("RoseDialogLine_r86o2")])
resource_name = "Menu 26"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_h8mgk"]
text = "And I saw the number 40 on their list. It means they installed 40 of these Mana Chargers."
next_menu = 28
resource_name = "NPC: And I saw the number 40 on their list. It means …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_hw8pw"]
lines = Array[Resource]([SubResource("RoseDialogLine_h8mgk")])
resource_name = "Menu 27"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_4ebe0"]
kind = "Answer"
text = "So, what's the problem?"
next_menu = 29
resource_name = "You: So, what's the problem?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_0qjsd"]
lines = Array[Resource]([SubResource("RoseDialogLine_4ebe0")])
resource_name = "Menu 28"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_477la"]
text = "Something terrible happened. The next day, monsters suddenly invaded town and killed many people. It was like hell on earth."
next_menu = 30
