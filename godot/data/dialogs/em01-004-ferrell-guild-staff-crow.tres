resource_name = "Menu 3"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_uok4n"]
text = "Yes, certain fees are required to use the Storage. Storage charges will differ depending on the type of item you wish to store. For items with steady prices, such as weapons and equipment, the storage fee is cheap. On the contrary, items with fluctuating prices, such as materials or usable items will require a more expensive storage fee. We have decided on this policy in order to prevent the hoarding and cornering of markets."
next_menu = 5
resource_name = "NPC: Yes, certain fees are required to use the Storag…"

