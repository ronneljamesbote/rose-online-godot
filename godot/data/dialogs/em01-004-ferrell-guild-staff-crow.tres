[sub_resource type="RoseDialogLine" id="RoseDialogLine_7uj88"]
text = "The specialty of our Storage is that this storage belongs to your account. Therefore, you can share items in the Storage among characters you have on the same server."
next_menu = 3
resource_name = "NPC: The specialty of our Storage is that this storag…"

