resource_name = "Menu 54"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_la330"]
text = "Haha, you're more level headed than you look. Alright, listen well. After Lucid married Namielle, it seemed that he changed a little. He began to give a little too much favoritism to the wealthy Lillith, who was one of the Seven Knights."
next_menu = 56
resource_name = "NPC: Haha, you're more level headed than you look. Al…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_l7bur"]
lines = Array[Resource]([SubResource("RoseDialogLine_la330")])
resource_name = "Menu 55"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_26q7j"]
kind = "Answer"
text = "Are you saying King Lucid was unfaithful?!"
next_menu = 57
resource_name = "You: Are you saying King Lucid was unfaithful?!"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_7e21y"]
lines = Array[Resource]([SubResource("RoseDialogLine_26q7j")])
resource_name = "Menu 56"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_v8j6a"]
text = "Whoa, don't jump to conclusions! Lillith was the youngest of the Seven Knights and loved Kirnale for a long time. However, Kirnale was harsh, aloof, and never returned her feelings. Out of pity, Lucid would trouble himself on her behalf."
next_menu = 58
resource_name = "NPC: Whoa, don't jump to conclusions! Lillith was the…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_t604w"]
lines = Array[Resource]([SubResource("RoseDialogLine_v8j6a")])
resource_name = "Menu 57"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_ms14c"]
kind = "Answer"
text = "Oh, okay. But what does that have to do with the Namielle's Wedding Ring?"
next_menu = 59
resource_name = "You: Oh, okay. But what does that have to do with the…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_5g5k2"]
lines = Array[Resource]([SubResource("RoseDialogLine_ms14c")])
resource_name = "Menu 58"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_krtdc"]
text = "Even if Lucid's intentions were good, Namielle grew jealous whenever she saw Lucid pay special attention to Lillith. She recognized the harm that such ugly feelings might cause, and struggled to control her heart. Eventually, she decided that she needed some special help to curb her jealousy."
next_menu = 60
resource_name = "NPC: Even if Lucid's intentions were good, Namielle g…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_jkqiq"]
lines = Array[Resource]([SubResource("RoseDialogLine_krtdc")])
resource_name = "Menu 59"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_eqo51"]
kind = "Answer"
text = "I see…"
next_menu = 61
resource_name = "You: I see…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_bhco8"]
lines = Array[Resource]([SubResource("RoseDialogLine_eqo51")])
resource_name = "Menu 60"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_1yo08"]
text = "Now don't get me wrong. When Lillith tried to follow Kirnale into the monster stronghold during the Second Monster Expedition, Namielle was really worried about her."
next_menu = 62
resource_name = "NPC: Now don't get me wrong. When Lillith tried to fo…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_ontdn"]
lines = Array[Resource]([SubResource("RoseDialogLine_1yo08")])
resource_name = "Menu 61"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_4xwf3"]
kind = "Answer"
text = "I guess Namielle would never put Lillith in danger, no matter how jealous she might be."
next_menu = 63
resource_name = "You: I guess Namielle would never put Lillith in dang…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_n4sss"]
lines = Array[Resource]([SubResource("RoseDialogLine_4xwf3")])
resource_name = "Menu 62"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_dod5u"]
text = "Lillith deeply loved Kirnale and it was her choice to follow him, no matter what. As for Namielle, she was like a mother figure to the Seven Knights. She always respected their opinions and would mediate arguments between them. I guess that's why it's so believable that she destroyed her wedding ring to persuade the Seven Knights to embark on the Second Monster Expedition."
next_menu = 64
resource_name = "NPC: Lillith deeply loved Kirnale and it was her choi…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_jhhav"]
lines = Array[Resource]([SubResource("RoseDialogLine_dod5u")])
resource_name = "Menu 63"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_i4m2y"]
kind = "Answer"
text = "She must be a greater person than most people would believe. Now I understand why she's known as the Mother of Akram."
next_menu = 65
resource_name = "You: She must be a greater person than most people wo…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_shs2j"]
lines = Array[Resource]([SubResource("RoseDialogLine_i4m2y")])
resource_name = "Menu 64"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_jfs6q"]
text = "That's right. Sadly, some people look down upon her as the incarnation of jealousy. Now, if someone found her wedding ring, that legend about Namielle sacrificing her ring for the sake of the Second Monster Expedition would be disproved. That might lead to a huge misunderstanding and Namielle's reputation could be ruined."
next_menu = 66
resource_name = "NPC: That's right. Sadly, some people look down upon …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_tjueg"]
lines = Array[Resource]([SubResource("RoseDialogLine_jfs6q")])
resource_name = "Menu 65"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_5vtfs"]
kind = "Answer"
text = "I see. But everyone thinks the ring was destroyed. I doubt anyone would go looking for it."
next_menu = 67
resource_name = "You: I see. But everyone thinks the ring was destroye…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_4llbg"]
lines = Array[Resource]([SubResource("RoseDialogLine_5vtfs")])
resource_name = "Menu 66"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_mxi0p"]
text = "True, but I know for a fact that it's still out there. It gives me shivers to think of what would happen if by some strange accident, someone were to find it. I wanted to find that ring first before anyone could disgrace Namielle's memory."
next_menu = 68
resource_name = "NPC: True, but I know for a fact that it's still out …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_ll4in"]
lines = Array[Resource]([SubResource("RoseDialogLine_mxi0p")])
resource_name = "Menu 67"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_mly8y"]
kind = "Answer"
text = "You’re really more considerate than you appear. It'd be best if I left this ring in your care."
next_menu = 69
resource_name = "You: You’re really more considerate than you appear. …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_05s7i"]
lines = Array[Resource]([SubResource("RoseDialogLine_mly8y")])
resource_name = "Menu 68"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_751va"]
text = "Thank you for listening to my story. However, there is one more potential discovery that worries me."
next_menu = 70
resource_name = "NPC: Thank you for listening to my story. However, th…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_yvr1p"]
lines = Array[Resource]([SubResource("RoseDialogLine_751va")])
resource_name = "Menu 69"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_sxxwn"]
kind = "Answer"
text = "What would that be?"
next_menu = 71
resource_name = "You: What would that be?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_h8gs3"]
lines = Array[Resource]([SubResource("RoseDialogLine_sxxwn")])
resource_name = "Menu 70"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_bmemn"]
text = "The Hairpins of Oblivious that suppress the jealousy in one's heart."
next_menu = 72
resource_name = "NPC: The Hairpins of Oblivious that suppress the jeal…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_3lj6k"]
lines = Array[Resource]([SubResource("RoseDialogLine_bmemn")])
resource_name = "Menu 71"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_ur24q"]
kind = "Answer"
text = "Just from its name, it seems like something you don't want anybody to find."
next_menu = 73
resource_name = "You: Just from its name, it seems like something you …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_6rrvw"]
lines = Array[Resource]([SubResource("RoseDialogLine_ur24q")])
resource_name = "Menu 72"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_y50nj"]
text = "Really? Anyway, it'd be best if you visit {fc=1}Lutis{/fc}, the researcher in the {fc=2}Valley of Luxem Tower{/fc}, so that he can tell you more about it. I hope you can find those hairpins so that Namielle can remain as Akram's mother in everyone's heart."
next_menu = 74
resource_name = "NPC: Really? Anyway, it'd be best if you visit {fc=1}…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_6epvr"]
