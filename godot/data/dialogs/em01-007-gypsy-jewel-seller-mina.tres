[sub_resource type="RoseDialogLine" id="RoseDialogLine_shyrc"]
kind = "Answer"
text = "Well, there's a rumor going around about it. Even Lisa in Junon Polis says looking for it is a waste of time. According to her, that ring's been smashed up."
