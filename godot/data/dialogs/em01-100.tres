resource_name = "Menu 7"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_2b5fj"]
text = "Well, I have all these gifts to deliver, but seeing as how you've been begging me for a present, I better do that myself. Hmm, why don't bring back those Santa Suits from those Rudolphs for me?"
