resource_name = "Menu 5"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_r2vyl"]
text = "Come back?! Haven't you heard that Rudolphs have been running around, masquerading as Santas?! They even had the audacity to turn our sacred Santa Suits… blue!"
