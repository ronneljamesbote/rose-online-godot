resource_name = "Menu 1"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_or060"]
text = "Present? I've got other things to worry about. Those Rudolphs I just hired stole all our precious Santa costumes and took off! Why are the rest of the Santas vacationing on Eldeon, while I'm the only one stuck here? I hate it! "
next_menu = 3
resource_name = "NPC: Present? I've got other things to worry about. T…"

