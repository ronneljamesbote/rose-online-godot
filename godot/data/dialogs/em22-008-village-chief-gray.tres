resource_name = "Menu 4"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_8k6gh"]
kind = "Answer"
text = "Why did you collect them?"
next_menu = 6
resource_name = "You: Why did you collect them?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_ixxfo"]
lines = Array[Resource]([SubResource("RoseDialogLine_8k6gh")])
resource_name = "Menu 5"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_w4356"]
text = "Because, I want to give the oysters to {fc=1}Francis{/fc}, a vicar of Junon Order in {fc=2}Zant{/fc}. I am sure he will promote me to an elder of the Junon Order once he receives this precious gift from me. Will you deliver this box to him?"
