[sub_resource type="RoseDialogLine" id="RoseDialogLine_sog8q"]
text = "Ah, you must be here to make a delivery, right? I've gathered pearl oysters for a year now. There were many times when I was tempted to open the pearl oysters to get their pearls. But I didn't, and gathered the oysters without opening any one of them so far."
next_menu = 5
resource_name = "NPC: Ah, you must be here to make a delivery, right? …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_fg3kv"]
