[sub_resource type="RoseDialogLine" id="RoseDialogLine_xmusf"]
text = "Of course you may join us. If you attain character Level 30, and are unaffiliated with another Faction, you will always be welcome. However, all of our new members are required to pay 30,000 Zulie as a training fee prior to joining."
next_menu = 7
resource_name = "NPC: Of course you may join us. If you attain charact…"

