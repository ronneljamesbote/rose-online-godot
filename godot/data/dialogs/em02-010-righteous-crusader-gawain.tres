[sub_resource type="RoseDialogLine" id="RoseDialogLine_rvd73"]
text = "The most important activity of the Righteous Crusader is protecting justice and eliminating evil. Therefore, we are supposed to go anywhere where the oppressed may need our help. You may wish to know that we are hostile to certain organizations such as the Junon Order and the Ikaness. Although there have been many serious disputes with them in the past, we must now unite to show them who is stronger."
next_menu = 9
resource_name = "NPC: The most important activity of the Righteous Cru…"

