[sub_resource type="RoseDialogLine" id="RoseDialogLine_nym4t"]
text = "We have been the official knights of the Akram Kingdom for a long time. We've also conflicted with religious organizations that are jealous of our reputation. Therefore, we're against the Junon Order and the Ikaness, and sometimes we have serious battles with them. On the contrary, we maintain close ties with the Ferrell Merchant Guild. We protect them from thieves and they supply us with weapons, armors and money."
next_menu = 11
resource_name = "NPC: We have been the official knights of the Akram K…"

