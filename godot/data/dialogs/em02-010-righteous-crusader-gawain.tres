[sub_resource type="RoseDialogLine" id="RoseDialogLine_wvimd"]
text = "The Righteous Crusaders are the official knights of the Akram Kingdom who protect the kingdom from injustice and disorder. If there is chaos, we decimate all that is evil to restore order."
