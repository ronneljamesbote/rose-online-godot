[sub_resource type="RoseDialogLine" id="RoseDialogLine_93bd2b"]
text = "A monster capsule holds a beast that fights for you. Use it and it comes out to fight by your side for a while. Calling one costs Stamina, so mind how tired you are. Here's a Jelly Bean: try it in the paddock. I sell capsules from Jelly Beans all the way up to the Goblin King."
resource_name = "NPC: A monster capsule holds a beast that fights for yo…"
next_menu = 7

