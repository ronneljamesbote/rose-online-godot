[sub_resource type="RoseDialogLine" id="RoseDialogLine_c954e4"]
text = "So this is the emblem Myad told me about. Red cloaks, poisoned mushrooms, and now this. Keep it safe for now: it will need to go to Luxem in the end. But first, my bridges."
