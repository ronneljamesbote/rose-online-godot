[sub_resource type="RoseDialogLine" id="RoseDialogLine_1a445"]
kind = "Answer"
text = "It's no use hiding anymore, we've been watching you through the Spirit Mirror! I can see that you've bound several hundred souls! {br} What exactly are you planning, Shroon?"
