[sub_resource type="RoseDialogLine" id="RoseDialogLine_brhgj"]
text = "Hmpf. So you've gone through so much trouble to spy on me. {br} In the end, I plan to create a perfect world with all of this power. Your puny mind couldn't possibly comprehend."
