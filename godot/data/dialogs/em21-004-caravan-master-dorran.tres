[sub_resource type="RoseDialogLine" id="RoseDialogLine_ap9ff902"]
text = "From Riverford? Corvel's seal, and... this emblem. The same patterns we found on the raiders' crates. You did right to bring it here. Rest at the camp, then come and talk to me about the road."
next_menu = 2
resource_name = "NPC: From Riverford? Corvel's seal, and... this emble…"

