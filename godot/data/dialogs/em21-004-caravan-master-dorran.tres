[sub_resource type="RoseDialogLine" id="RoseDialogLine_a304a3"]
text = "Another traveller through the Sandgate! The road to Zant is longer than it looks, and the valley has turned strange. Before you go on, see Mira on the rock over there. She has the best eyes in the camp."
