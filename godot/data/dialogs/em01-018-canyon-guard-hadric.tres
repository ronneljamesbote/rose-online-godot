[sub_resource type="RoseDialogLine" id="RoseDialogLine_bf0370"]
text = "Rackies on the Wind Road, sandstorms from El Verloon, and Woopies. A big Woopie that calls himself king sits in the hollow south-east of the city with his court. Leave him be unless you're ready for him."
next_menu = 4
resource_name = "NPC: Rackies on the Wind Road, sandstorms from El Verlo…"

