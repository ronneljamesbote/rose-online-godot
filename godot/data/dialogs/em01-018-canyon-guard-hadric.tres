[sub_resource type="RoseDialogLine" id="RoseDialogLine_870f6b"]
text = "East, through the Wind Road Caravan Camp, is Breezy Hills: start there. South is the gate to the Valley of Luxem Tower, where you came from. North, over the bridge, is the El Verloon Desert, and that's no place for a beginner."
next_menu = 2
resource_name = "NPC: East, through the Wind Road Caravan Camp, is Breez…"

