[sub_resource type="RoseDialogLine" id="RoseDialogLine_p0eek"]
text = "Epidemic? Oh, you must be the one that Myad sent. Well, I don’t know anything about this disease. After all, I'm not really a doctor. But now that I think about it, I saw some people in red robes camping around that field where the mushrooms grow. Then, after a few days, they just disappeared. It didn't really bother me at the time since adventurers are always coming and going in this area, but now it does seem too coincidental."
next_menu = 17
resource_name = "NPC: Epidemic? Oh, you must be the one that Myad sent…"

