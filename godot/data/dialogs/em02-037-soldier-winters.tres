[sub_resource type="RoseDialogLine" id="RoseDialogLine_4k7wr"]
kind = "Answer"
text = "Yes, I've come here to ask you about this Golden Dagger. Lutis told me that you should be able to tell whether it's authentic or not."
next_menu = 5
resource_name = "You: Yes, I've come here to ask you about this Golden…"

