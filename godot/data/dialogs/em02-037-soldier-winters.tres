resource_name = "Menu 4"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_3wxeh"]
text = "Let me see. I've never seen anything like this dagger before. It feels like it's overflowing with elegance. If it were something from this area, I'd know right away but I don't think I'm qualified to judge this dagger's authenticity. I don't think anyone on Junon can, actually."
next_menu = 6
resource_name = "NPC: Let me see. I've never seen anything like this d…"

