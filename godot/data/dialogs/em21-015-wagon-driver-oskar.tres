[sub_resource type="RoseDialogLine" id="RoseDialogLine_4cb186"]
text = "Dorran... thank the stars. Cowboy Pumpkins jumped us in the wadi. They took every crate up to their perch in the red rocks. And the river, it was dry, all of it. It was full last month."
next_menu = 2
resource_name = "NPC: Dorran... thank the stars. Cowboy Pumpkins jumpe…"

