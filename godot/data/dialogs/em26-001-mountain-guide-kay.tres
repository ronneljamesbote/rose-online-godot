[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_wnl5a"]
lines = Array[Resource]([SubResource("RoseDialogLine_fhymj")])
resource_name = "Menu 29"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_dpuui"]
text = "I suppose it would be absurd for me to share this delicious coffee with anybody else. Now, let me tell you my story."
next_menu = 31
resource_name = "NPC: I suppose it would be absurd for me to share thi…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_3uwrg"]
lines = Array[Resource]([SubResource("RoseDialogLine_dpuui")])
resource_name = "Menu 30"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_yn27u"]
kind = "Answer"
text = "Yes, please tell me."
next_menu = 32
resource_name = "You: Yes, please tell me."

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_d74fu"]
lines = Array[Resource]([SubResource("RoseDialogLine_yn27u")])
resource_name = "Menu 31"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_44lmh"]
text = "You know I'm the guide here at this forest, don't you? There are so many monsters here, so I'm constantly being offered new weapons from Junon Polis. But as you know, they're quite burdensome to carry around."
next_menu = 33
resource_name = "NPC: You know I'm the guide here at this forest, don'…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_xiyul"]
lines = Array[Resource]([SubResource("RoseDialogLine_44lmh")])
resource_name = "Menu 32"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_4k1px"]
kind = "Answer"
text = "Yes, I know."
next_menu = 34
resource_name = "You: Yes, I know."

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_j8vyy"]
lines = Array[Resource]([SubResource("RoseDialogLine_4k1px")])
resource_name = "Menu 33"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_nd0sl"]
text = "So, I had to rest on my way from Junon Polis, and I fell asleep. While I was sleeping, the Doongas took all of my weapon boxes."
next_menu = 35
resource_name = "NPC: So, I had to rest on my way from Junon Polis, an…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_me81c"]
lines = Array[Resource]([SubResource("RoseDialogLine_nd0sl")])
resource_name = "Menu 34"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_ao612"]
kind = "Answer"
text = "So you want me to retrieve these lost boxes?"
next_menu = 36
resource_name = "You: So you want me to retrieve these lost boxes?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_jlgsi"]
lines = Array[Resource]([SubResource("RoseDialogLine_ao612")])
resource_name = "Menu 35"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_wu0pq"]
text = "Bingo! But I chased after them and know where you can find them. Those Doongas opened the boxes and threw them away when they found out that their contents weren't edible."
next_menu = 37
resource_name = "NPC: Bingo! But I chased after them and know where yo…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_48agl"]
lines = Array[Resource]([SubResource("RoseDialogLine_wu0pq")])
resource_name = "Menu 36"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_prrjf"]
kind = "Answer"
text = "Couldn't you have just taken the boxes right then?"
next_menu = 38
resource_name = "You: Couldn't you have just taken the boxes right the…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_thfng"]
lines = Array[Resource]([SubResource("RoseDialogLine_prrjf")])
resource_name = "Menu 37"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_he7uc"]
text = "Of course I wanted to, but then those boxes were taken by the Master Golems. Out of the frying pan and into the fire, as they say."
next_menu = 39
resource_name = "NPC: Of course I wanted to, but then those boxes were…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_221b8"]
lines = Array[Resource]([SubResource("RoseDialogLine_he7uc")])
resource_name = "Menu 38"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_nwsbs"]
kind = "Answer"
text = "Why didn't you just fight them?"
next_menu = 40
resource_name = "You: Why didn't you just fight them?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_w4l7a"]
lines = Array[Resource]([SubResource("RoseDialogLine_nwsbs")])
resource_name = "Menu 39"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_4vpfw"]
text = "Maybe you could, but I'm too old for that kind of ruckus. That's why I'm asking you now."
next_menu = 41
resource_name = "NPC: Maybe you could, but I'm too old for that kind o…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_si7lu"]
lines = Array[Resource]([SubResource("RoseDialogLine_4vpfw")])
resource_name = "Menu 40"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_6h5pj"]
kind = "Answer"
text = "I see… So then I should investigate Master Golems?"
next_menu = 42
resource_name = "You: I see… So then I should investigate Master Golem…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_bqmon"]
lines = Array[Resource]([SubResource("RoseDialogLine_6h5pj")])
resource_name = "Menu 41"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_wmkh1"]
text = "Yes, {fc=12}Master Golems{/fc} took my boxes. I know those monsters are really tough, but it can't be helped."
next_menu = 43
resource_name = "NPC: Yes, {fc=12}Master Golems{/fc} took my boxes. I …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_hj6pm"]
lines = Array[Resource]([SubResource("RoseDialogLine_wmkh1")])
resource_name = "Menu 42"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_ssrgk"]
kind = "Answer"
text = "Wouldn't have been better to carry everything in just one box?"
next_menu = 44
resource_name = "You: Wouldn't have been better to carry everything in…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_bq4q3"]
lines = Array[Resource]([SubResource("RoseDialogLine_ssrgk")])
resource_name = "Menu 43"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_6g3k0"]
text = "I did! But I put {fc=14}11 Old Boxes{/fc} in that 1 big box."
next_menu = 45
