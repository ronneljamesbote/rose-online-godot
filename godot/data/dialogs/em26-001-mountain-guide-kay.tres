resource_name = "Menu 56"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_rf5f2"]
kind = "Answer"
text = "Oh, I didn't know they were friends. Now that you mention it, they're a lot alike."
next_menu = 58
resource_name = "You: Oh, I didn't know they were friends. Now that yo…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_hepef"]
