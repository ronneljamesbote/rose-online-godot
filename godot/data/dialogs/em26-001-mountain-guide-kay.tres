text = "Huh? But the way you do things is confusing…"
next_menu = 54
resource_name = "You: Huh? But the way you do things is confusing…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_0s4a5"]
lines = Array[Resource]([SubResource("RoseDialogLine_oqj25")])
resource_name = "Menu 53"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_mo2g2"]
text = "Anyway, several days ago, Bith told me that Arumic research which was proceeding at Gorge of Silence has stopped. Something interfered with the research, but he couldn't tell other people what it was."
next_menu = 55
resource_name = "NPC: Anyway, several days ago, Bith told me that Arum…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_3shcq"]
