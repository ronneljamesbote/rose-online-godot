text = "What happened?"
next_menu = 56
resource_name = "You: What happened?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_yq1gq"]
lines = Array[Resource]([SubResource("RoseDialogLine_unwwx")])
resource_name = "Menu 55"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_a5twp"]
text = "Well, I don't know in detail, but Bith's old friend, Med, disappeared after going into the Gorge of Silence. A search has begun for Med, but as an old friend and a fellow member of the Ferrell Guild, Bith is still worried."
next_menu = 57
resource_name = "NPC: Well, I don't know in detail, but Bith's old fri…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_0k4b4"]
