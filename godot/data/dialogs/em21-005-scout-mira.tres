[sub_resource type="RoseDialogLine" id="RoseDialogLine_0m95o"]
text = "So Dorran sent you up here. Good. From this rock I can see the whole valley, and the dust on the road gets thicker every day. Stay close to the camp at first. If you fall out there, our medic will patch you up here."
next_menu = 2
resource_name = "NPC: So Dorran sent you up here. Good. From this rock…"

