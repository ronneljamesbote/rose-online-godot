lines = Array[Resource]([SubResource("RoseDialogLine_cp3v2")])
resource_name = "Menu 80"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_1xv54"]
kind = "Answer"
text = "Don't worry, I simply did want I wanted to do. Still, it wasn't too hard to find the Family Emblem. Why wasn't it discovered earlier?"
next_menu = 82
resource_name = "You: Don't worry, I simply did want I wanted to do. S…"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_micim"]
kind = "Answer"
text = "Don't worry, I simply did want I wanted to do. By the way, what became of Lillith's love for Kirnale? Did he ever return her feelings?"
next_menu = 96
resource_name = "You: Don't worry, I simply did want I wanted to do. B…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_15nmn"]
lines = Array[Resource]([SubResource("RoseDialogLine_1xv54"), SubResource("RoseDialogLine_micim")])
resource_name = "Menu 81"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_wbb4c"]
text = "Lillith abandoned her status as a woman of a noble family, and chose to live as a warrior, and later as the economic specialist of the Akram Kingdom. She didn't have any problems, aside from the loneliness that she could never satisfy."
next_menu = 83
resource_name = "NPC: Lillith abandoned her status as a woman of a nob…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_kur7l"]
lines = Array[Resource]([SubResource("RoseDialogLine_wbb4c")])
resource_name = "Menu 82"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_w653s"]
kind = "Answer"
text = "Loneliness…?"
next_menu = 84
resource_name = "You: Loneliness…?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_q0hr0"]
lines = Array[Resource]([SubResource("RoseDialogLine_w653s")])
resource_name = "Menu 83"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_nif7k"]
text = "As I told you, she joined the Seven Knights because she was in love with Kirnale. Even after the First Monster Expedition was over, she continued to love him. However, he never so much as looked at her, and chose to immerse himself in compiling what we now know as Kirnale's Journals."
next_menu = 85
resource_name = "NPC: As I told you, she joined the Seven Knights beca…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_xepxj"]
lines = Array[Resource]([SubResource("RoseDialogLine_nif7k")])
resource_name = "Menu 84"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_ih8op"]
kind = "Answer"
text = "That sounds pretty heartless."
next_menu = 86
resource_name = "You: That sounds pretty heartless."

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_n1deh"]
lines = Array[Resource]([SubResource("RoseDialogLine_ih8op")])
resource_name = "Menu 85"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_e03mr"]
text = "Lillith never gave up and continued loving Kirnale whole heartedly, believing that someday he would accept her affections. It's well known that Lillith wrote many heartfelt letters for Kirnale that she placed in glass bottles."
next_menu = 87
resource_name = "NPC: Lillith never gave up and continued loving Kirna…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_a33eh"]
lines = Array[Resource]([SubResource("RoseDialogLine_e03mr")])
resource_name = "Menu 86"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_70vpp"]
kind = "Answer"
text = "Letters in a bottle? Didn't they do that a long time ago? You know, if you were stuck on a deserted island and wanted someone to find you?"
next_menu = 88
resource_name = "You: Letters in a bottle? Didn't they do that a long …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_afgwg"]
lines = Array[Resource]([SubResource("RoseDialogLine_70vpp")])
resource_name = "Menu 87"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_5wuxs"]
text = "Yes, that's right. While Kirnale was compiling his journals, he also traveled throughout the Akram Kingdom to gather more information. Lillith cast many glass bottles containing letters into the sea so that Kirnale may find them wherever he went."
next_menu = 89
resource_name = "NPC: Yes, that's right. While Kirnale was compiling h…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_268d3"]
lines = Array[Resource]([SubResource("RoseDialogLine_5wuxs")])
resource_name = "Menu 88"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_u5lbt"]
kind = "Answer"
text = "But if she did that, not all of the letters would be found by Kirnale. It's highly likely that a complete stranger would find them!"
next_menu = 90
resource_name = "You: But if she did that, not all of the letters woul…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_1sy47"]
lines = Array[Resource]([SubResource("RoseDialogLine_u5lbt")])
resource_name = "Menu 89"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_5knc7"]
text = "That's right. In fact, a great number of people on Kenji Beach have found Lillith's love letters."
next_menu = 91
resource_name = "NPC: That's right. In fact, a great number of people …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_mqj1y"]
lines = Array[Resource]([SubResource("RoseDialogLine_5knc7")])
resource_name = "Menu 90"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_6v4er"]
kind = "Answer"
text = "I wonder what Lillith wrote in her letters to Kirnale. I'd like to read them if I can get a chance."
next_menu = 92
resource_name = "You: I wonder what Lillith wrote in her letters to Ki…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_6472d"]
lines = Array[Resource]([SubResource("RoseDialogLine_6v4er")])
resource_name = "Menu 91"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_fslj6"]
text = "Aren't you the curious type? Well, why don't you visit {fc=1}Hotch{/fc} in {fc=2}Kenji Beach{/fc} if you want to see some of Lillith's love letters?"
next_menu = 93
resource_name = "NPC: Aren't you the curious type? Well, why don't you…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_vx0s8"]
lines = Array[Resource]([SubResource("RoseDialogLine_fslj6")])
resource_name = "Menu 92"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_ye12e"]
kind = "Answer"
text = "Really? Then I should go to Kenji Beach and meet Hotch."
next_menu = 94
resource_name = "You: Really? Then I should go to Kenji Beach and meet…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_0mbe6"]
lines = Array[Resource]([SubResource("RoseDialogLine_ye12e")])
resource_name = "Menu 93"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_4jl4s"]
text = "Oh, and leave the Family Emblem here with me. I'll need this to restore Lillith's honor."
next_menu = 95
resource_name = "NPC: Oh, and leave the Family Emblem here with me. I'…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_7l5ql"]
lines = Array[Resource]([SubResource("RoseDialogLine_4jl4s")])
resource_name = "Menu 94"

