[sub_resource type="RoseDialogLine" id="RoseDialogLine_grfls"]
text = "First, the Ferrell Guild can't afford to cheat its customers. Our success depends on customer loyalty and repeat business. Second, we care about the quality of our service. If we show our customers that we care, occasional mistakes on our part are more forgivable. Positive business relationships are more important for long term success than the short term swindle."
