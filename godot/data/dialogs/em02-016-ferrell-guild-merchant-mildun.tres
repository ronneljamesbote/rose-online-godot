[sub_resource type="RoseDialogLine" id="RoseDialogLine_ih2ya"]
kind = "Answer"
text = "Right, I understand."
on_choose = Array[Resource]([SubResource("RoseDialogCase_h25rg")])
resource_name = "You: Right, I understand."

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_6qx3g"]
lines = Array[Resource]([SubResource("RoseDialogLine_ih2ya")])
resource_name = "Menu 95"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_bs08o"]
text = "Kirnale seemed to be the awkward sort in that he immersed himself in his work when a cute girl like Lillith was earnestly expressing her love for him."
next_menu = 97
resource_name = "NPC: Kirnale seemed to be the awkward sort in that he…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_p8wpy"]
