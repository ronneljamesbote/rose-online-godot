[sub_resource type="RoseDialogLine" id="RoseDialogLine_qqn28"]
text = "That's right. Despite her age, she was a genius at trading. The Seven Knights obtained many rare items during their adventures which Lillith would purchase cheaply and sell at a high price. Her skills ensured that the Seven Knights' expeditions would be well financed."
