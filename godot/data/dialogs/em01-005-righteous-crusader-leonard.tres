[sub_resource type="RoseDialogLine" id="RoseDialogLine_mact5"]
text = "Originally, the Righteous Crusaders were mercenaries for hire. However, we quickly became known for our brave exploits. In battle we earned the respect and honor of the people of Junon. When the Junon kingdoms were united into one, the Righteous Crusaders were promoted to become the official knights of the Akram Kingdom. If you're interested, I will recommend you to my superior."
