[sub_resource type="RoseDialogLine" id="RoseDialogLine_bdaede"]
text = "Hear how it sings in your hands? You found it. That is the first lesson, and the hardest. From today you are a Muse. Let me give you something to carry the mana with. A staff, or a wand?"
next_menu = 8
resource_name = "NPC: Hear how it sings in your hands? You found it. T…"

