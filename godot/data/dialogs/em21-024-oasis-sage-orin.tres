resource_name = "You: About \"The Sage's Trial\""

[sub_resource type="RoseDialogLine" id="RoseDialogLine_5f34ce"]
text = "Close your eyes. Can you feel it? The valley is full of mana right now, more than it should be, and the Pomics soak it up like sponges. A Muse must learn to find mana and to take it. Bring me 6 handfuls of the dust that hums. Then I will teach you to use what you found."
next_menu = 4
resource_name = "NPC: Close your eyes. Can you feel it? The valley is …"

