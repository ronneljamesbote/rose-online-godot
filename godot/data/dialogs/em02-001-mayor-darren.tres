resource_name = "Menu 12"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_k5mwu"]
text = "I said that it's about time you change your job into the 2nd class. When you advance in your job, you can learn new skills and use new weapons. So, what do you say?"
