resource_name = "Menu 7"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_mobrk"]
text = "Junon Polis was built right after the Akram Kingdom unified this whole planet. Originally, this was but a small harbor village. The Kingdom developed the harbor which allowed the village economy to flourish with the increase in shipping and trades. Eventually, strongholds were built to ensure the people's safety, and this city has grown and developed into the capital of the Akram Kingdom."
next_menu = 9
resource_name = "NPC: Junon Polis was built right after the Akram King…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_iw51o"]
