resource_name = "Menu 9"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_drnm0"]
text = "You must first attain character Level 70 of the 1st class. You will be tested for your qualification, and you must donate a specific amount of Zulie for the developing fund. If you think you are ready, come back to me anytime."
