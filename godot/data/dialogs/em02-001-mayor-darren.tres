resource_name = "Menu 5"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_y62jk"]
text = "No, I couldn't say that. If it were not for the cooperation and diligence of the people of Junon Polis, we would not be where we are today. I appreciate the efforts and contributions of all who live here, even the animals."
next_menu = 7
resource_name = "NPC: No, I couldn't say that. If it were not for the …"

