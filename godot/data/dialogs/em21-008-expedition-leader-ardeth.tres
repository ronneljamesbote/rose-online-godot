text = "I'll do it."
next_menu = 6
on_choose = Array[Resource]([SubResource("RoseDialogCase_cdf9d8")])
resource_name = "You: I'll do it."

[sub_resource type="RoseDialogLine" id="RoseDialogLine_7bf1a0"]
kind = "Answer"
text = "Not now."
next_menu = -1
resource_name = "You: Not now."

[sub_resource type="RoseDialogLine" id="RoseDialogLine_ba9846"]
text = "When you're ready, ask me to ride the crane down. Gus runs the lift in the vault; he'll bring you back up."
next_menu = 2
resource_name = "NPC: When you're ready, ask me to ride the crane down…"

