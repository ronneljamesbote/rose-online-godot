[sub_resource type="RoseDialogLine" id="RoseDialogLine_86d595"]
text = "A Pomic shard, soaked in mana. Shannon was right to send you. This is what we came for: the tower is failing, and the valley pays for it. My people could use someone like you."
next_menu = 2
resource_name = "NPC: A Pomic shard, soaked in mana. Shannon was right…"

