[sub_resource type="RoseDialogLine" id="RoseDialogLine_61d236"]
text = "Pell's reading matches what we found. Under the dig there is a sealed vault, and something in it is waking. My crane can lower you inside. Defeat the Ruin Warden and bring me the Lens Core it guards. Take friends if you have them."
next_menu = 5
resource_name = "NPC: Pell's reading matches what we found. Under the …"

