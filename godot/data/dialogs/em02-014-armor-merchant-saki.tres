resource_name = "Menu 6"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_fn6kr"]
text = "As the Devil Pest spread throughout the world, and monsters grew more violent, the Seven Knights gathered for the first time. They could not eliminate all the monsters, but they were able to bring peace to the people, at least for a while. The Seven Knights were Lucid, his wife Namielle, Kirnale the Adventurer, Lillith, who was the daughter of a millionaire, Seyrun the Sage, Night Shade the Assassinator, and Bardsrin the Bard."
next_menu = 8
resource_name = "NPC: As the Devil Pest spread throughout the world, a…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_ot7lh"]
lines = Array[Resource]([SubResource("RoseDialogLine_fn6kr")])
resource_name = "Menu 7"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_38jl2"]
kind = "Answer"
text = "One of the Seven Knights, eh? What kind of person was Kirnale?"
next_menu = 9
resource_name = "You: One of the Seven Knights, eh? What kind of perso…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_3v4v3"]
lines = Array[Resource]([SubResource("RoseDialogLine_38jl2")])
resource_name = "Menu 8"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_4m2dx"]
text = "He was a genius, an expert in scouting and exploration, as well as a prolific inventor. He was always exploring uncharted areas, and invented many tools that helped him in his reconnaissance."
next_menu = 10
resource_name = "NPC: He was a genius, an expert in scouting and explo…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_p1m73"]
lines = Array[Resource]([SubResource("RoseDialogLine_4m2dx")])
resource_name = "Menu 9"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_ha444"]
kind = "Answer"
text = "So what kind of things did he invent?"
next_menu = 11
resource_name = "You: So what kind of things did he invent?"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_axwph"]
kind = "Answer"
text = "What kind of personality did Kirnale have?"
next_menu = 19
resource_name = "You: What kind of personality did Kirnale have?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_c1rau"]
lines = Array[Resource]([SubResource("RoseDialogLine_ha444"), SubResource("RoseDialogLine_axwph")])
resource_name = "Menu 10"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_0unuk"]
text = "There are far too many to mention, but a few of his most important ones were the compass and the sundial. The ones that we use nowadays are based off Kirnale's original designs."
next_menu = 12
resource_name = "NPC: There are far too many to mention, but a few of …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_6i1e7"]
lines = Array[Resource]([SubResource("RoseDialogLine_0unuk")])
resource_name = "Menu 11"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_73w6j"]
kind = "Answer"
text = "Wow, that's incredible! Do you know if anyone has the first compass and sundial that Kirnale created?"
next_menu = 13
resource_name = "You: Wow, that's incredible! Do you know if anyone ha…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_xkc7j"]
lines = Array[Resource]([SubResource("RoseDialogLine_73w6j")])
resource_name = "Menu 12"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_wlju2"]
text = "I don't think so. Kirnale's only weakness was his atrocious forgetfulness. It is said that he lost his compass and portable sundial somewhere around Kenji Beach."
next_menu = 14
resource_name = "NPC: I don't think so. Kirnale's only weakness was hi…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_vmkei"]
lines = Array[Resource]([SubResource("RoseDialogLine_wlju2")])
resource_name = "Menu 13"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_lp3r7"]
kind = "Answer"
text = "Interesting. So he was really forgetful. But still, it doesn't look like those relics can be recovered."
next_menu = 15
resource_name = "You: Interesting. So he was really forgetful. But sti…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_fqalc"]
