[sub_resource type="RoseDialogLine" id="RoseDialogLine_v4bx5"]
text = "Although Kirnale was a man of very few words, he was actually a very kind person. However, he was extremely forgetful and often lost his things."
next_menu = 20
resource_name = "NPC: Although Kirnale was a man of very few words, he…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_xfyo2"]
lines = Array[Resource]([SubResource("RoseDialogLine_v4bx5")])
resource_name = "Menu 19"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_rxtib"]
kind = "Answer"
text = "Well, no one in this world can be perfect."
next_menu = 21
resource_name = "You: Well, no one in this world can be perfect."

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_un5qh"]
lines = Array[Resource]([SubResource("RoseDialogLine_rxtib")])
resource_name = "Menu 20"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_re6ea"]
text = "In any case, many of his original inventions are still around, but his especially important compass and sundial were lost because of his forgetfulness."
next_menu = 22
resource_name = "NPC: In any case, many of his original inventions are…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_xfr35"]
lines = Array[Resource]([SubResource("RoseDialogLine_re6ea")])
resource_name = "Menu 21"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_dt3ds"]
kind = "Answer"
text = "What a shame! But aren't we using compasses and sundials today?"
next_menu = 23
resource_name = "You: What a shame! But aren't we using compasses and …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_trr3g"]
lines = Array[Resource]([SubResource("RoseDialogLine_dt3ds")])
resource_name = "Menu 22"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_u3bb2"]
text = "Yes, because the technology has been handed down. Still, the original compass and sundial that Kirnale invented have been lost."
next_menu = 24
resource_name = "NPC: Yes, because the technology has been handed down…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_in1o2"]
