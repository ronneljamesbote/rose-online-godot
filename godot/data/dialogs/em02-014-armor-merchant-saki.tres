resource_name = "NPC: Something else occurred because of Kirnale's for…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_pfuq4"]
lines = Array[Resource]([SubResource("RoseDialogLine_rcc21")])
resource_name = "Menu 31"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_ua8bd"]
kind = "Answer"
text = "Really? And what would that be?"
next_menu = 33
resource_name = "You: Really? And what would that be?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_qtufy"]
lines = Array[Resource]([SubResource("RoseDialogLine_ua8bd")])
resource_name = "Menu 32"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_klbhg"]
text = "Kirnale's forgetfulness was so bad that he'd return from an adventure and forget where he had gone and what he did. Since information is vital to explorers, Kirnale decided to write down notes for everything he had learned and discovered."
next_menu = 34
resource_name = "NPC: Kirnale's forgetfulness was so bad that he'd ret…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_q6fhc"]
lines = Array[Resource]([SubResource("RoseDialogLine_klbhg")])
resource_name = "Menu 33"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_gqkij"]
kind = "Answer"
text = "Hahah! But wouldn't he forget to take down notes, or lose the notes altogether?"
next_menu = 35
resource_name = "You: Hahah! But wouldn't he forget to take down notes…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_hhmnu"]
lines = Array[Resource]([SubResource("RoseDialogLine_gqkij")])
resource_name = "Menu 34"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_ye53k"]
text = "Fortunately for us, that didn't happen. Although he was that forgetful…"
next_menu = 36
resource_name = "NPC: Fortunately for us, that didn't happen. Although…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_fhnhd"]
lines = Array[Resource]([SubResource("RoseDialogLine_ye53k")])
resource_name = "Menu 35"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_l87gc"]
kind = "Answer"
text = "In that case, he must have taken a huge amount of notes."
next_menu = 37
resource_name = "You: In that case, he must have taken a huge amount o…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_bh7mf"]
lines = Array[Resource]([SubResource("RoseDialogLine_l87gc")])
resource_name = "Menu 36"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_g3irj"]
text = "Yes. When he returned from the First Monster Expedition, he compiled his notes into 5 volumes which detail region information, monster attributes, and solutions for dangerous situations. Kirnale's Journals should be in the custody of Jones, the historian in Junon Polis."
next_menu = 38
resource_name = "NPC: Yes. When he returned from the First Monster Exp…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_epc1x"]
lines = Array[Resource]([SubResource("RoseDialogLine_g3irj")])
resource_name = "Menu 37"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_h4c7d"]
kind = "Answer"
text = "Kirnale's Journals… Do you think Jones would let me read them?"
next_menu = 39
resource_name = "You: Kirnale's Journals… Do you think Jones would let…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_qatjk"]
lines = Array[Resource]([SubResource("RoseDialogLine_h4c7d")])
resource_name = "Menu 38"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_k7e6m"]
text = "You should be able to read them as much as you like. They're considered public property after all."
next_menu = 40
resource_name = "NPC: You should be able to read them as much as you l…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_npxfo"]
lines = Array[Resource]([SubResource("RoseDialogLine_k7e6m")])
resource_name = "Menu 39"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_88ohg"]
kind = "Answer"
text = "Great! Then I'll go and visit Jones so that I can take a look at those journals."
next_menu = 41
resource_name = "You: Great! Then I'll go and visit Jones so that I ca…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_boslq"]
lines = Array[Resource]([SubResource("RoseDialogLine_88ohg")])
resource_name = "Menu 40"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_wmtku"]
text = "{fc=1}Jones{/fc} should be around the lighthouse in {fc=2}Junon Polis{/fc}. While you're there, please give Kirnale's Compass and Portable Sundial to Jones. It's best if the relics of Junon's history are placed in his care."
