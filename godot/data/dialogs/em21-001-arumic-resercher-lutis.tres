[sub_resource type="RoseDialogLine" id="RoseDialogLine_66582d"]
text = "The Lens Core! Hold on... there. Look at the crystal. It's shining again, and I can hear the spring below us running stronger. The valley will heal. Thank you, <NAME>. This last piece completes your set. Karitte wants to speak with you too, and then your road goes on: through the north-west gate to Zant, the Canyon City. Ask for Lena, the guide. She knows everyone there."
next_menu = 59
resource_name = "NPC: The Lens Core! Hold on... there. Look at the cry…"

