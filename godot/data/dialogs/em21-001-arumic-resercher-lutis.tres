[sub_resource type="RoseDialogLine" id="RoseDialogLine_5u4g5"]
text = "Namielle's Hairpins? You must be speaking of the Hairpins of Oblivious that my ancestor created to suppress Namielle's jealousy."
next_menu = 11
resource_name = "NPC: Namielle's Hairpins? You must be speaking of the…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_ts3p2"]
lines = Array[Resource]([SubResource("RoseDialogLine_5u4g5")])
resource_name = "Menu 10"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_wxv5f"]
kind = "Answer"
text = "Yes, that's right. So one of your ancestors created the hairpins?"
next_menu = 12
resource_name = "You: Yes, that's right. So one of your ancestors crea…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_hq4gb"]
lines = Array[Resource]([SubResource("RoseDialogLine_wxv5f")])
resource_name = "Menu 11"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_nqm16"]
text = "Correct. Namielle truly was a kind woman, but was unaccustomed to dealing with the dark feelings of jealousy. She suffered greatly, trying to suppress those feelings alone. For a while, she used to power of her faith to control her jealousy of Lillith, but there came a day when the burden grew too great for her to endure. On that day, she came to my ancestor."
next_menu = 13
resource_name = "NPC: Correct. Namielle truly was a kind woman, but wa…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_41nac"]
lines = Array[Resource]([SubResource("RoseDialogLine_nqm16")])
resource_name = "Menu 12"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_bqeqi"]
kind = "Answer"
text = "So when her faith wasn't enough, she resorted to magic hairpins? That's ironic."
next_menu = 14
resource_name = "You: So when her faith wasn't enough, she resorted to…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_enq3v"]
lines = Array[Resource]([SubResource("RoseDialogLine_bqeqi")])
resource_name = "Menu 13"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_uuge2"]
text = "On Junon, the power of faith and the power of magic are deeply linked. That may explain why the Junon Order and the Arumics have been long time allies. In any case, my ancestor felt very sorry for Namielle and created 5 Hairpins of Oblivious which would suppress the jealousy in her heart."
next_menu = 15
