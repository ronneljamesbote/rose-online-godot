[sub_resource type="RoseDialogLine" id="RoseDialogLine_fa7703"]
kind = "Answer"
text = "I'll do it."
next_menu = 5
on_choose = Array[Resource]([SubResource("RoseDialogCase_2cbba1")])
resource_name = "You: I'll do it."

[sub_resource type="RoseDialogLine" id="RoseDialogLine_7bf1a0"]
kind = "Answer"
text = "Not now."
next_menu = -1
resource_name = "You: Not now."

[sub_resource type="RoseDialogLine" id="RoseDialogLine_ed76c8"]
text = "The bees swarm around the dead trees with hives, on the flats and by the road. Be quicker than them."
next_menu = 2
resource_name = "NPC: The bees swarm around the dead trees with hives,…"

