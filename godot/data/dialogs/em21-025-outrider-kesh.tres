text = "\"The Outrider's Trial\": it's done."
next_menu = 7
show_if = Array[Resource]([SubResource("RoseDialogCase_474f47")])
resource_name = "You: \"The Outrider's Trial\": it's done."

[sub_resource type="RoseDialogLine" id="RoseDialogLine_6b4bc0"]
text = "Ten, and barely a scratch on you. You're quick. From today you're a Hawker, and you ride with the outriders. Take a weapon from me: a bow to hit them from far away, or a katar to hit them up close?"
next_menu = 8
resource_name = "NPC: Ten, and barely a scratch on you. You're quick. …"

