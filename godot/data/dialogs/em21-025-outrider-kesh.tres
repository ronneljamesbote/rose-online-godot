resource_name = "You: About \"The Outrider's Trial\""

[sub_resource type="RoseDialogLine" id="RoseDialogLine_558255"]
text = "A Hawker hits first and is gone before the other side knows. Honeybees are the fastest things in this valley. Bring me 10 of their wings, in one piece. Do it and you'll ride out with me as a Hawker."
next_menu = 4
resource_name = "NPC: A Hawker hits first and is gone before the other…"

[sub_resource type="RoseDialogDoQuestStep" id="RoseDialogDoQuestStep_eea330"]
step = ExtResource("x_2beec0")

