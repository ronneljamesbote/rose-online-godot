[sub_resource type="RoseDialogLine" id="RoseDialogLine_owpdm"]
text = "Although the Akram Kingdom sent me to Kenji Beach to discourage me from being involved in Cart related work, it doesn't mean that I've lost any of my passion for Carts. So, have you already learned about the origin of Carts?"
next_menu = 4
resource_name = "NPC: Although the Akram Kingdom sent me to Kenji Beac…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_4j8pp"]
