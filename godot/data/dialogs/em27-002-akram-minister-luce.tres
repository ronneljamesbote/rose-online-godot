[sub_resource type="RoseDialogLine" id="RoseDialogLine_78oub"]
text = "Good, then let me teach you about the Cart's technical aspects. Carts consist of a Cart Body, Cart Engine and Cart Wheels. When you obtain each part, they will be stored in your Tuning Window instead of the Inventory Window. When you combine those three parts in the Tuning Window, you can finally operate the Cart you've just assembled."
next_menu = 6
resource_name = "NPC: Good, then let me teach you about the Cart's tec…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_jfdk1"]
