resource_name = "Menu 5"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_hg085"]
kind = "Answer"
text = "Where can I obtain the parts for a Cart?"
next_menu = 7
resource_name = "You: Where can I obtain the parts for a Cart?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_fkyma"]
lines = Array[Resource]([SubResource("RoseDialogLine_hg085")])
resource_name = "Menu 6"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_7m71i"]
text = "Well, I'm not sure whether or not you can buy them from normal NPC shops. However, Dealers do have a unique skill which allows them to create Cart parts. If you have a Dealer friend, it'd be smart to ask him."
next_menu = 8
resource_name = "NPC: Well, I'm not sure whether or not you can buy th…"

