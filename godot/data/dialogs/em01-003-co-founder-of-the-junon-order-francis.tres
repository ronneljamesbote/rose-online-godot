[sub_resource type="RoseDialogLine" id="RoseDialogLine_5fc88"]
text = "Hmm, that sounds fair. Then we will postpone our sanctuary construction for 3 years while their new home is built. We're also willing to take care of the Ikaness members' construction expenses. However, we cannot afford to send a messenger to inform the Ikaness of this decision. <NAME>, will you do it for us?"
