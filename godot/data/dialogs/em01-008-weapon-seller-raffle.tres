[sub_resource type="RoseDialogLine" id="RoseDialogLine_gu7vb"]
text = "Sure, there is. Let me explain. First, weapons are classified as one-handed or two-handed. One-handed weapons allow you to equip a shield on the other hand, so it's best for increasing your defense. On the contrary, two handed weapons give you more attacking power, but don't offer any defensive advantages."
next_menu = 3
resource_name = "NPC: Sure, there is. Let me explain. First, weapons a…"

