resource_name = "Menu 59"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_vnx4j"]
text = "Kirnale was the greatest explorer and inventor of his time. During his adventures with the Seven Knights, he collected a vast amount of information that he organized into what is now known as Kirnale's Journals. At any rate, Namielle flung away her Old Priest Chain to save her life."
next_menu = 61
resource_name = "NPC: Kirnale was the greatest explorer and inventor o…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_sve0h"]
lines = Array[Resource]([SubResource("RoseDialogLine_vnx4j")])
resource_name = "Menu 60"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_i3f4x"]
kind = "Answer"
text = "The answer's simple, isn't it? Just get the Old Priest Chain from Junon's KingKong."
next_menu = 56
resource_name = "You: The answer's simple, isn't it? Just get the Old …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_d2wjn"]
lines = Array[Resource]([SubResource("RoseDialogLine_i3f4x")])
resource_name = "Menu 61"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_3x3qn"]
text = "Yes, that's right. It was Queen of the Akram Kingdom that Namielle gradually brought peace to her people. True to her training as a priestess, Namielle had great compassion for Akram's citizens, and she was very popular during her reign."
next_menu = 63
resource_name = "NPC: Yes, that's right. It was Queen of the Akram Kin…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_phyvj"]
