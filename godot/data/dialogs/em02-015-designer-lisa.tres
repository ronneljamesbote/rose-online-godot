resource_name = "Menu 69"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_q6qpd"]
text = "After the First Monster Expedition, the Seven Knights returned and established the Akram Kingdom. Lucid became king and married Namielle. Queen Namielle worked diligently to ensure the prosperity of the Akram Kingdom."
