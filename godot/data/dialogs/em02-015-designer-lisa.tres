resource_name = "You: Namielle was a priestess?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_1q78e"]
lines = Array[Resource]([SubResource("RoseDialogLine_34g6s")])
resource_name = "Menu 63"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_s48xi"]
text = "She used to be a priestess of the Junon Order. As violent monsters began to overwhelm the people of Junon, she resigned from her position as priestess to join the other Six Knights in exterminating them. It was during these adventures in the Seven Knights that she fell in love with Lucid. "
next_menu = 65
resource_name = "NPC: She used to be a priestess of the Junon Order. A…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_06c8k"]
lines = Array[Resource]([SubResource("RoseDialogLine_s48xi")])
resource_name = "Menu 64"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_l83u6"]
kind = "Answer"
text = "Ah, that seems so romantic."
next_menu = 66
resource_name = "You: Ah, that seems so romantic."

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_3atsm"]
lines = Array[Resource]([SubResource("RoseDialogLine_l83u6")])
resource_name = "Menu 65"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_kwyfn"]
text = "She's also famous for creating many supportive spells based on holy power that were instrumental to the success of the First Monster Expedition. Many of the supportive spells that Muses and Clerics use today are based on those invented by Namielle."
next_menu = 67
resource_name = "NPC: She's also famous for creating many supportive s…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_0u458"]
lines = Array[Resource]([SubResource("RoseDialogLine_kwyfn")])
resource_name = "Menu 66"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_gfp4c"]
kind = "Answer"
text = "Are you telling me that my spells are all from Namielle?"
next_menu = 50
resource_name = "You: Are you telling me that my spells are all from N…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_b2lse"]
lines = Array[Resource]([SubResource("RoseDialogLine_gfp4c")])
resource_name = "Menu 67"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_sa64n"]
text = "That's right. She took an active part in eliminating monsters with six other heroes. During these adventures as one of the Seven Knights, Namielle fell in love with their leader, Lucid."
next_menu = 69
resource_name = "NPC: That's right. She took an active part in elimina…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_i53od"]
lines = Array[Resource]([SubResource("RoseDialogLine_sa64n")])
resource_name = "Menu 68"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_n1oi1"]
