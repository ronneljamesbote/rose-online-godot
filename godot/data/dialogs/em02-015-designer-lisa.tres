resource_name = "Menu 87"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_4ahwc"]
text = "Her wedding ring is symbolic of her role as queen of the Akram Kingdom. In destroying it, she severed her ties to her monarchal position and symbolically returned to her role as warrior."
next_menu = 89
resource_name = "NPC: Her wedding ring is symbolic of her role as quee…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_xharc"]
lines = Array[Resource]([SubResource("RoseDialogLine_4ahwc")])
resource_name = "Menu 88"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_jetxu"]
kind = "Answer"
text = "So she supported the Second Expedition, no matter what the cost. Still, it seems like such a waste. And there must be no trace of the ring if it was smashed by Lucid's Sword."
next_menu = 90
resource_name = "You: So she supported the Second Expedition, no matte…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_0haqw"]
lines = Array[Resource]([SubResource("RoseDialogLine_jetxu")])
resource_name = "Menu 89"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_atl5q"]
text = "Yes, it's most likely. Ah, but there are still some funny people who insist that the ring still exists. The idea of that is quite laughable, really."
