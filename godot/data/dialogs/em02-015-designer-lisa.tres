text = "During the Second Expedition, the Seven Knights found themselves in battle with a great number of Doongas. Suddenly, {fc=12}Junon's KingKong{/fc} appeared right in front of Namielle. Just when it was about to kill her, she remembered that Kirnale mentioned that Junon's KingKong was attracted by metal objects. She flung her Old Priest Chain away, Junon's KingKong ran to chase after it, and Namielle was able to save herself."
next_menu = 55
resource_name = "NPC: During the Second Expedition, the Seven Knights …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_oeyad"]
