[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_lyrom"]
lines = Array[Resource]([SubResource("RoseDialogLine_64rfn")])
resource_name = "Menu 81"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_r86te"]
text = "At one time, yes. But before the Second Monster Expedition, they changed. When King Lucid and Queen Namielle were busy bringing stability to the Akram Kingdom, the monsters grew in strength and numbers. When Lucid made the decision to lead a second expedition to completely exterminate the monster threat, Kirnale and Lillith opposed him."
next_menu = 83
resource_name = "NPC: At one time, yes. But before the Second Monster …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_80v6a"]
lines = Array[Resource]([SubResource("RoseDialogLine_r86te")])
resource_name = "Menu 82"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_p0nls"]
kind = "Answer"
text = "Why would they oppose him? I don't understand."
next_menu = 84
resource_name = "You: Why would they oppose him? I don't understand."

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_hmbc4"]
lines = Array[Resource]([SubResource("RoseDialogLine_p0nls")])
resource_name = "Menu 83"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_s2dvl"]
text = "Kirnale was compiling his journals based on the notes he took during the First Monster Expedition. I'm certain he wanted to finish this work instead of going on another expedition. Lillith also opposed the expedition, but only because she was in love with Kirnale."
next_menu = 85
resource_name = "NPC: Kirnale was compiling his journals based on the …"

