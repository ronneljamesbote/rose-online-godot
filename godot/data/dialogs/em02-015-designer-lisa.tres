resource_name = "Menu 79"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_mawlx"]
text = "I want the Junon Order to keep the Old Priest Chain so that it can investigate its secrets. I can't entrust this to anyone else, lest they succumb to greed or desire. Just like Kirnale and Lillith."
next_menu = 81
resource_name = "NPC: I want the Junon Order to keep the Old Priest Ch…"

