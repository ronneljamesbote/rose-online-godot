next_menu = 86
resource_name = "You: What? Are you sure that's what happened?"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_42fxd"]
kind = "Answer"
text = "I can't understand why Kirnale and Lillith would oppose the Second Monster Expedition, especially since they were heroes. There must be some reason…"
