resource_name = "Menu 85"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_onrtd"]
text = "I doubt it. In any case, Namielle eventually persuaded Kirnale and Lillith to join them in the Second Expedition by taking her wedding ring, and smashing it to pieces with Lucid's Sword."
