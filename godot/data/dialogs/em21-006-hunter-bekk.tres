[sub_resource type="RoseDialogLine" id="RoseDialogLine_cd9fe2"]
text = "The Pumpkins have moved out of the fields and onto the road. Wagons can't pass when they block it. Thin them out and bring me 10 of their stalks, so I know it's done."
next_menu = 4
resource_name = "NPC: The Pumpkins have moved out of the fields and on…"

