resource_name = "Menu 24"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_sc0aw"]
text = "Yes, it was in that beautiful way that Kirnale and Lillith left this world. Although it's sad, it must be wonderful to be with the one that you love in the very end. Even though I'll never be able to see Kirnale himself, I would love to be able to see his {fc=14}Phoenix Writing Quill{/fc}."
