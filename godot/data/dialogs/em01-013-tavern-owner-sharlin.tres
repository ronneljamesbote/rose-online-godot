resource_name = "Menu 9"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_dugus"]
kind = "Answer"
text = "I didn't know Lillith joined the First Monster Expedition because she fell in love with Kirnale."
next_menu = 11
resource_name = "You: I didn't know Lillith joined the First Monster E…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_g2cka"]
lines = Array[Resource]([SubResource("RoseDialogLine_dugus")])
resource_name = "Menu 10"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_qsit3"]
text = "Oh yes, she did. By chance, Kirnale passed through Lillith's town and once she set eyes upon him, she loved him for the rest of her life. Even though she was the precious daughter of a very wealthy man, she threw everything away to follow Kirnale."
next_menu = 12
resource_name = "NPC: Oh yes, she did. By chance, Kirnale passed throu…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_cgrxh"]
lines = Array[Resource]([SubResource("RoseDialogLine_qsit3")])
resource_name = "Menu 11"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_mweer"]
kind = "Answer"
text = "But what about the others in the Seven Knights? Did they welcome her?"
next_menu = 13
resource_name = "You: But what about the others in the Seven Knights? …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_j6e3w"]
lines = Array[Resource]([SubResource("RoseDialogLine_mweer")])
resource_name = "Menu 12"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_alpai"]
text = "At first, her father opposed her participation in the expedition, but she eventually persuaded him to fund the efforts of the Seven Knights. Lillith had a talent for trading, and was able to sell the rare items that the Seven Knights found for great prices, so her skills came to be greatly appreciated by the other six heroes."
next_menu = 14
resource_name = "NPC: At first, her father opposed her participation i…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_we0n2"]
lines = Array[Resource]([SubResource("RoseDialogLine_alpai")])
resource_name = "Menu 13"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_iobpq"]
kind = "Answer"
text = "Wow, that's an amazing accomplishment, especially since she was so young. I still have trouble calculating my income and expenses. At any rate, was Kirnale in love with Lillith too?"
next_menu = 15
resource_name = "You: Wow, that's an amazing accomplishment, especiall…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_sej17"]
lines = Array[Resource]([SubResource("RoseDialogLine_iobpq")])
resource_name = "Menu 14"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_jdbmu"]
text = "Well, Kirnale was a really awkward person. Although the lovely Lillith was wholeheartedly showing her love for him, it seemed that he was only concerned with exploration and his inventions."
next_menu = 16
resource_name = "NPC: Well, Kirnale was a really awkward person. Altho…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_076mg"]
lines = Array[Resource]([SubResource("RoseDialogLine_jdbmu")])
resource_name = "Menu 15"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_u6pd7"]
kind = "Answer"
text = "Wow. That's pretty heartless."
next_menu = 17
resource_name = "You: Wow. That's pretty heartless."

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_12eiu"]
lines = Array[Resource]([SubResource("RoseDialogLine_u6pd7")])
resource_name = "Menu 16"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_lb2hq"]
text = "Heartless? To me, he just had a very masculine sense of romance! Oh, he was so dreamy! So anyway, wherever Kirnale went, Lillith would follow."
next_menu = 18
resource_name = "NPC: Heartless? To me, he just had a very masculine s…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_72wjq"]
lines = Array[Resource]([SubResource("RoseDialogLine_lb2hq")])
resource_name = "Menu 17"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_pcq1q"]
kind = "Answer"
text = "I think I've heard something like this. She took Kirnale's side when he initially opposed the Second Monster Expedition. She also followed him into the monster stronghold from which the Seven Knights were never heard from again."
next_menu = 19
resource_name = "You: I think I've heard something like this. She took…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_t4iyc"]
lines = Array[Resource]([SubResource("RoseDialogLine_pcq1q")])
resource_name = "Menu 18"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_e2l4s"]
text = "That's right. Even though Kirnale outwardly never expressed it, he was moved by Lillith and deep in his heart, he appreciated her affection."
next_menu = 20
resource_name = "NPC: That's right. Even though Kirnale outwardly neve…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_ig4pd"]
