[sub_resource type="RoseDialogLine" id="RoseDialogLine_rhifl"]
kind = "Answer"
text = "Well, I'm a little worried. Just this once, I suppose I can let you keep it. But you've got to keep this a secret."
next_menu = 47
resource_name = "You: Well, I'm a little worried. Just this once, I su…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_7envx"]
