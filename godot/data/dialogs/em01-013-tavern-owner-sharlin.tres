resource_name = "Menu 44"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_e52il"]
text = "I understand that, but isn't there any way I could change your mind? I'd keep it a secret. Please let me have this memento of Kirnale!"
next_menu = 46
resource_name = "NPC: I understand that, but isn't there any way I cou…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_lx2t1"]
