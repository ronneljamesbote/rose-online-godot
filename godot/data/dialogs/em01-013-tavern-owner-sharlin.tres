resource_name = "You: How did he do that? Was it romantic?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_hvexf"]
lines = Array[Resource]([SubResource("RoseDialogLine_jbdhi")])
resource_name = "Menu 22"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_14coq"]
text = "Because of his forgetfulness, Kirnale had a habit of always writing notes with his Phoenix Writing Quill. In the end, he gave his precious quill to Lillith. Now imagine. In a moment of sheer terror, facing a dreadful death from which there's no hope of escape, you awkwardly give a present to the one person that you love."
next_menu = 24
resource_name = "NPC: Because of his forgetfulness, Kirnale had a habi…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_xh584"]
lines = Array[Resource]([SubResource("RoseDialogLine_14coq")])
resource_name = "Menu 23"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_fl8kk"]
kind = "Answer"
text = "So in his final moments, Kirnale finally opened his heart. Lillith must have passed away happily."
next_menu = 25
resource_name = "You: So in his final moments, Kirnale finally opened …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_jrphv"]
