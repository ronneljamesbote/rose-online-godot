[sub_resource type="RoseDialogLine" id="RoseDialogLine_cv4vw"]
kind = "Answer"
text = "I really should be put this quill in the custody of Jones the historian. After all, this is a priceless historical relic of Junon!"
next_menu = 45
resource_name = "You: I really should be put this quill in the custody…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_pxmq5"]
