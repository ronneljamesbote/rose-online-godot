resource_name = "Menu 46"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_q80mt"]
text = "Thank you, thank you so much! You don't have to worry about me letting anyone else know, I'll keep our secret. Now, I just have to repay you! Let me write you a letter of recommendation that you can take to {fc=1}Darren{/fc}, the mayor of {fc=2}Junon Polis{/fc}. If you bring it to him, you should be able to be promoted to a higher job."
next_menu = 48
resource_name = "NPC: Thank you, thank you so much! You don't have to …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_v1dai"]
