resource_name = "Menu 7"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_ec5f16"]
text = "Six. All poisoned, and all from the same red-sealed sacks. Go back to Corvel and tell him. And watch the hollow to the west."
next_menu = 2
resource_name = "NPC: Six. All poisoned, and all from the same red-sea…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_31faef"]
