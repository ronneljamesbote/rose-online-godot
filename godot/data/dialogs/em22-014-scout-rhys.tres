[sub_resource type="RoseDialogLine" id="RoseDialogLine_85ca04"]
text = "Corvel sent you? Good. Look at this camp: cold fire, torn tents, and seed sacks gone black. Somebody poisoned that seed and fed it to the plain."
next_menu = 2
resource_name = "NPC: Corvel sent you? Good. Look at this camp: cold f…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_289a7c"]
lines = Array[Resource]([SubResource("RoseDialogLine_85ca04")])
resource_name = "Menu 3"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_a6ba30"]
text = "The Choropies round here dragged the sacks off. Bring me six of them back so Corvel can see what we're dealing with."
next_menu = 5
resource_name = "NPC: The Choropies round here dragged the sacks off. …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_2bd2da"]
