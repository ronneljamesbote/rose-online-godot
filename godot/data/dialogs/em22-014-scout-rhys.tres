resource_name = "Menu 8"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_43436a"]
text = "The Jelly King. It gorged itself on the seed and it's twice the size it was. Don't go in alone."
next_menu = 2
resource_name = "NPC: The Jelly King. It gorged itself on the seed and…"

