[sub_resource type="RoseDialogLine" id="RoseDialogLine_4ec68e"]
text = "The Spotted and Mother Choropies round the camp have them. They're tougher than they look."
next_menu = 2
resource_name = "NPC: The Spotted and Mother Choropies round the camp …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_4d087e"]
