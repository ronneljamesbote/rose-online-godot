resource_name = "Menu 6"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_289dea"]
text = "Six Rotten Seed Sacks, from the Choropies round the camp."
next_menu = 2
resource_name = "NPC: Six Rotten Seed Sacks, from the Choropies round …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_bb99c5"]
