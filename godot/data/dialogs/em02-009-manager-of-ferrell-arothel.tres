[sub_resource type="RoseDialogLine" id="RoseDialogLine_v2jvi"]
text = "The Ferrell Guild is endeavoring to take control of Junon Planet's market. Because of the scope of our goal, we can always use more manpower. Your labor will never be in vain, so work hard for us and you'll be financially compensated."
