[sub_resource type="RoseDialogLine" id="RoseDialogLine_a3fb61"]
text = "Eight, and every one humming. The stones are calling the jellies here, but something else is sickening the plain. Old Myad on the pier has been asking for help. Go and see him."
next_menu = 2
resource_name = "NPC: Eight, and every one humming. The stones are cal…"

