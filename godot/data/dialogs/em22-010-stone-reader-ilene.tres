resource_name = "Menu 7"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_723a16"]
text = "Nobody remembers. The rune stones are older than Arua's Landing. I read what I can of them, and write down the rest."
next_menu = 2
resource_name = "NPC: Nobody remembers. The rune stones are older than…"

