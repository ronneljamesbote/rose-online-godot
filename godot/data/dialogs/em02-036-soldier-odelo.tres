[sub_resource type="RoseDialogLine" id="RoseDialogLine_ih4y5"]
kind = "Answer"
text = "Did the Prince of Akram really run away?"
next_menu = 7
resource_name = "You: Did the Prince of Akram really run away?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_41vkr"]
lines = Array[Resource]([SubResource("RoseDialogLine_ih4y5")])
resource_name = "Menu 6"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_fvg6b"]
text = "Huh. Another story that's a waste of my time. Why are you asking me this?"
next_menu = 8
resource_name = "NPC: Huh. Another story that's a waste of my time. Wh…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_mc5ig"]
lines = Array[Resource]([SubResource("RoseDialogLine_fvg6b")])
resource_name = "Menu 7"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_wowtw"]
kind = "Answer"
text = "Well, I'm just concerned. After I gave the Zeppastone to Punwell, he told me the Prince ran away from home to look for the Zeppastone."
next_menu = 9
resource_name = "You: Well, I'm just concerned. After I gave the Zeppa…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_xural"]
lines = Array[Resource]([SubResource("RoseDialogLine_wowtw")])
resource_name = "Menu 8"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_0x2p0"]
text = "I've searched all over Junon Planet for any information on the Prince's whereabouts. Now, supposedly, someone at Kenji Beach found the last remaining trace of the Prince, although I'm suspicious of whether or not this story is true. In any case, the story about the Prince leaving home to seek the Zeppastone is just a groundless rumor. That's not the reason the Prince ran away."
next_menu = 10
resource_name = "NPC: I've searched all over Junon Planet for any info…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_2t27o"]
lines = Array[Resource]([SubResource("RoseDialogLine_0x2p0")])
resource_name = "Menu 9"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_r0s58"]
kind = "Answer"
text = "But couldn't he have gone to Kenji Beach to look for the Zeppastone?"
next_menu = 11
resource_name = "You: But couldn't he have gone to Kenji Beach to look…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_q4jfs"]
lines = Array[Resource]([SubResource("RoseDialogLine_r0s58")])
resource_name = "Menu 10"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_iftyf"]
text = "Weren't you the one who found the Zeppastone? Now, everyone knows it's hidden in the Goblin Caves. If the Prince was looking at the Wind Gem, there's no reason for him to go to Kenji Beach."
next_menu = 12
resource_name = "NPC: Weren't you the one who found the Zeppastone? No…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_68b0u"]
lines = Array[Resource]([SubResource("RoseDialogLine_iftyf")])
resource_name = "Menu 11"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_pylby"]
kind = "Answer"
text = "Wait. Everyone knew it was in the Goblin Cave? I thought its location was a mystery!"
next_menu = 13
resource_name = "You: Wait. Everyone knew it was in the Goblin Cave? I…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_b65nx"]
lines = Array[Resource]([SubResource("RoseDialogLine_pylby")])
resource_name = "Menu 12"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_5wips"]
text = "Mystery? Well, it was to a certain extent. Yeah, I guess so. Anyway, the prince hasn’t come back yet, but I wouldn't worry about him. He's a brilliant man. But if you're still worried, you should talk to Gallahad, who is in custody of the Prince's possessions."
next_menu = 14
resource_name = "NPC: Mystery? Well, it was to a certain extent. Yeah,…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_fhtmf"]
lines = Array[Resource]([SubResource("RoseDialogLine_5wips")])
resource_name = "Menu 13"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_hp7oo"]
kind = "Answer"
text = "Alright, I understand. So what earthly belongings did the Prince leave behind?"
next_menu = 15
resource_name = "You: Alright, I understand. So what earthly belonging…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_gnxn2"]
lines = Array[Resource]([SubResource("RoseDialogLine_hp7oo")])
resource_name = "Menu 14"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_7p5uq"]
text = "H-hey! We're not sure if the Prince is dead or not! Anyway, {fc=1}Gallahad{/fc} is in custody of the Prince's Gold Dagger, which is given to every member of the royal family. If you meet Gallahad, tell him that he should return the dagger to the royal family."
next_menu = 16
resource_name = "NPC: H-hey! We're not sure if the Prince is dead or n…"

