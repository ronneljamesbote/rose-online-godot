resource_name = "Menu 165"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_irvqu"]
kind = "Answer"
text = "Really? Thank you! Now I think I better tell everything to the person I was first trying to help. Thank you so much for your help!"
next_menu = 167
resource_name = "You: Really? Thank you! Now I think I better tell eve…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_dhjh1"]
