[sub_resource type="RoseDialogLine" id="RoseDialogLine_qqgyv"]
text = "This city consists of three major parts: the Palace, the Main Streets and the Harbor. The general public is not allowed to enter the Palace. Within the main streets, there's the Faction Headquarters, shops, the Storage and a bank. You can also meet the ministers of the Akram Kingdom in the main street as well. You can travel to other areas in Junon by using ships found in the harbor."
