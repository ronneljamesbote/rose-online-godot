[sub_resource type="RoseDialogLine" id="RoseDialogLine_13a78f"]
text = "Lena's pupil? Then you know your way around Zant. The Wind Road runs east through this gate into Breezy Hills. Keep a Zant Return Scroll in your bag, and good luck out there."
