[sub_resource type="RoseDialogLine" id="RoseDialogLine_cu48u"]
text = "Here in the Adventurer's Village, you can buy weapons and clothes for Visitors, as well as food, such as fresh fruit. While you're here, why don't you try talking to the other people here in the village? I'm sure that you can learn a lot from them."
next_menu = 23
resource_name = "NPC: Here in the Adventurer's Village, you can buy we…"

