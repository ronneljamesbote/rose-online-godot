resource_name = "Menu 18"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_1na52"]
kind = "Answer"
text = "Really? Then, I'd like to go there as soon as I can."
next_menu = 0
resource_name = "You: Really? Then, I'd like to go there as soon as I …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_805av"]
lines = Array[Resource]([SubResource("RoseDialogLine_1na52")])
resource_name = "Menu 19"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_hhe8m"]
text = "Why don't you talk to other people in Zant? You can learn all kinds of information and maybe even land a part time job. You can also buy things from shops that you might need later. When you get a chance, you might want to talk to Myad, the old man by the sea, since he's been helping out Visitors as well."
next_menu = 21
resource_name = "NPC: Why don't you talk to other people in Zant? You …"

