[sub_resource type="RoseDialogLine" id="RoseDialogLine_hnh7w"]
text = "Once you reach Level 10, go to the Sandwind Caravan Camp in the Valley of Luxem Tower, past the gates on Gatehill. Four job mentors wait there, one for each class. Pass a mentor's trial and they change your job right at the camp."
