[sub_resource type="RoseDialogLine" id="RoseDialogLine_eqv3c"]
text = "Ministers from the Akram Kingdom have been dispatched to Zant so that they may handle 1st class job changes for Visitors. There are many goods and people gathered in this town, as well as necessities that are essential for exploring the land. Zant seems to be the true starting point for the adventures of the Visitors."
next_menu = 19
resource_name = "NPC: Ministers from the Akram Kingdom have been dispa…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_qdrr0"]
