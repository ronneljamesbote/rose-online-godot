[sub_resource type="RoseDialogLine" id="RoseDialogLine_a65001"]
text = "Eight. You stood your ground, and that's all a Soldier really is. From today you're one of us. Every Soldier of the caravan gets a blade from me. Which kind?"
next_menu = 8
resource_name = "NPC: Eight. You stood your ground, and that's all a S…"

