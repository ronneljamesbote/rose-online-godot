text = "Not now."
next_menu = -1
resource_name = "You: Not now."

[sub_resource type="RoseDialogLine" id="RoseDialogLine_0490a7"]
text = "North of the camp, past the road. The fields with the dead crops. Don't come back with fewer than eight."
next_menu = 2
resource_name = "NPC: North of the camp, past the road. The fields wit…"

