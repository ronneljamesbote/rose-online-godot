[sub_resource type="RoseDialogLine" id="RoseDialogLine_bc5877"]
text = "You want to be a Soldier? Then show me you can stand in front of something and not run. The Elder Pumpkins in the Withered Fields hit hard and don't give up. Bring me 8 of their thorned vines. Come back alive and I'll make you a Soldier, here and now."
next_menu = 4
resource_name = "NPC: You want to be a Soldier? Then show me you can s…"

