[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_0psph"]
lines = Array[Resource]([SubResource("RoseDialogLine_78ag8")])
resource_name = "Menu 36"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_hr0ki"]
text = "Lillith was the greatest Dealer of her time. Without her, the Akram Kingdom would not have had a fair market, as well as the widely established ethical system that we all use in training and business."
