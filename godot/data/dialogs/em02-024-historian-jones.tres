resource_name = "Menu 11"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_3adal"]
text = "With the invention of the Mana Engine, one of the most amazing inventions in the world, the Visitors used Carts and Castle Gears to hunt monsters more efficiently. However, the steam exhaust from the Mana engine chemically reacts with the Devil Pest virus, creating a new, super powerful virus. Monsters affected by this new virus have died one by one."
next_menu = 13
resource_name = "NPC: With the invention of the Mana Engine, one of th…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_ibhav"]
