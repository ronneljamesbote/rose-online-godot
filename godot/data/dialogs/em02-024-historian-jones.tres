[sub_resource type="RoseDialogLine" id="RoseDialogLine_6dhm2"]
text = "What? Did you just say you restored Lucid's Sword? Wow, I can't believe that! You must be the hero everybody has been dreaming about!"
next_menu = 104
resource_name = "NPC: What? Did you just say you restored Lucid's Swor…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_k8t87"]
