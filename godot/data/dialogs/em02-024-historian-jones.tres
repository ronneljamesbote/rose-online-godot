resource_name = "Menu 12"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_b2r14"]
kind = "Answer"
text = "If this virus is killing off the monsters, isn't that a good thing?"
next_menu = 14
resource_name = "You: If this virus is killing off the monsters, isn't…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_p21ba"]
lines = Array[Resource]([SubResource("RoseDialogLine_b2r14")])
resource_name = "Menu 13"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_ltl5q"]
text = "Yes, this was the case at first. So, the Visitors infected the monsters with the virus and killed them in great numbers. However, some monsters gained immunity to the virus and grew stronger. These monsters are so powerful that Visitors can no longer fight them alone."
next_menu = 15
resource_name = "NPC: Yes, this was the case at first. So, the Visitor…"

