text = "So did this guy just take the journals and run?"
next_menu = 78
resource_name = "You: So did this guy just take the journals and run?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_qqiwh"]
lines = Array[Resource]([SubResource("RoseDialogLine_3bv2y")])
resource_name = "Menu 77"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_g17cs"]
text = "No, no, he merely lost his bag when running from danger while he was in the Goblin Cave."
next_menu = 79
resource_name = "NPC: No, no, he merely lost his bag when running from…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_ceews"]
lines = Array[Resource]([SubResource("RoseDialogLine_g17cs")])
resource_name = "Menu 78"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_be847"]
kind = "Answer"
text = "And Kirnale's Journals were inside the bag."
next_menu = 80
resource_name = "You: And Kirnale's Journals were inside the bag."

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_ww7n3"]
lines = Array[Resource]([SubResource("RoseDialogLine_be847")])
resource_name = "Menu 79"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_f8onm"]
text = "You're right. So I sent out many brave explorers to retrieve those notes, but none of them has succeeded yet."
next_menu = 81
resource_name = "NPC: You're right. So I sent out many brave explorers…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_tma51"]
lines = Array[Resource]([SubResource("RoseDialogLine_f8onm")])
resource_name = "Menu 80"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_ow546"]
kind = "Answer"
text = "Still, if almost every detail related to adventuring was recorded in Kirnale's Journals, couldn't that adventurer have avoided any dangerous situations?"
next_menu = 82
resource_name = "You: Still, if almost every detail related to adventu…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_eqtgd"]
lines = Array[Resource]([SubResource("RoseDialogLine_ow546")])
resource_name = "Menu 81"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_uv2vb"]
text = "Well, I need to tell you a somewhat long story to explain that. After the First Monster Expedition, Lucid and other heroes established the Akram Kingdom. Lucid became the first king and married with Namielle with whom he fell in love during the 1st monster expedition. King Lucid and Queen Namielle, together with the rest of the Seven Knights, were united to help their people recover from the damages caused by the monsters. Slowly but surely, the economy and politics of the kingdom stabilized."
next_menu = 83
resource_name = "NPC: Well, I need to tell you a somewhat long story t…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_homgk"]
lines = Array[Resource]([SubResource("RoseDialogLine_uv2vb")])
resource_name = "Menu 82"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_lajno"]
kind = "Answer"
text = "Did Kirnale help Lucid for the sake of the kingdom as well?"
next_menu = 84
resource_name = "You: Did Kirnale help Lucid for the sake of the kingd…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_2pioi"]
lines = Array[Resource]([SubResource("RoseDialogLine_lajno")])
resource_name = "Menu 83"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_lbuu8"]
text = "Of course. The Seven Knights always worked together. Anyway, during this time, Kirnale organized all of the notes he had taken during the First Expedition into what are now known as Kirnale's Journals. He had intended to write 7 volumes, but only managed to complete 5 of them before he died."
next_menu = 85
resource_name = "NPC: Of course. The Seven Knights always worked toget…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_ipgtb"]
lines = Array[Resource]([SubResource("RoseDialogLine_lbuu8")])
resource_name = "Menu 84"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_njm5r"]
kind = "Answer"
text = "So you're saying that Kirnale's Journals are incomplete. If you're just relying on those journals, you can still run into unexpected situations."
next_menu = 86
resource_name = "You: So you're saying that Kirnale's Journals are inc…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_1tyte"]
lines = Array[Resource]([SubResource("RoseDialogLine_njm5r")])
resource_name = "Menu 85"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_s0lss"]
text = "Yes, I should have told that adventurer before he left."
next_menu = 87
resource_name = "NPC: Yes, I should have told that adventurer before h…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_syj4f"]
lines = Array[Resource]([SubResource("RoseDialogLine_s0lss")])
resource_name = "Menu 86"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_7ttjb"]
kind = "Answer"
text = "But why wasn't Kirnale able to complete all of his journals?"
next_menu = 88
resource_name = "You: But why wasn't Kirnale able to complete all of h…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_4y8o1"]
lines = Array[Resource]([SubResource("RoseDialogLine_7ttjb")])
resource_name = "Menu 87"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_o8lxi"]
text = "Because of the Second Monster Expedition. About a year after the Akram Kingdom was established, the power of the monsters grew once again at an alarming rate. Lucid decided to go on another monster expedition in order to truly eliminate the monster threat, but Kirnale opposed this idea."
next_menu = 89
resource_name = "NPC: Because of the Second Monster Expedition. About …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_cg8c4"]
lines = Array[Resource]([SubResource("RoseDialogLine_o8lxi")])
resource_name = "Menu 88"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_qkbs4"]
kind = "Answer"
text = "Why is that? It seems like such a great opportunity for exploration."
next_menu = 90
resource_name = "You: Why is that? It seems like such a great opportun…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_xar80"]
lines = Array[Resource]([SubResource("RoseDialogLine_qkbs4")])
resource_name = "Menu 89"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_0swbh"]
text = "Kirnale was mostly concerned that the Akram Kingdom would once again grow unstable without the Seven Knights."
next_menu = 91
resource_name = "NPC: Kirnale was mostly concerned that the Akram King…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_jstr3"]
lines = Array[Resource]([SubResource("RoseDialogLine_0swbh")])
resource_name = "Menu 90"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_wbd2x"]
kind = "Answer"
text = "He seems like such a kind person."
next_menu = 92
resource_name = "You: He seems like such a kind person."

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_r1xxf"]
lines = Array[Resource]([SubResource("RoseDialogLine_wbd2x")])
resource_name = "Menu 91"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_cqlwr"]
text = "Yes. Lillith also agreed with Kirnale, but when Queen Namielle accused Kirnale of opposing the expedition in order to finish compiling his journals, Kirnale had to agree to the Second Monster Expedition."
next_menu = 93
resource_name = "NPC: Yes. Lillith also agreed with Kirnale, but when …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_w3poa"]
lines = Array[Resource]([SubResource("RoseDialogLine_cqlwr")])
resource_name = "Menu 92"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_besn0"]
kind = "Answer"
text = "So they went their second, and final, monster expedition. And the journals were never finished."
next_menu = 94
resource_name = "You: So they went their second, and final, monster ex…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_h78qb"]
lines = Array[Resource]([SubResource("RoseDialogLine_besn0")])
resource_name = "Menu 93"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_mmxat"]
text = "That's right."
next_menu = 95
resource_name = "NPC: That's right."

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_vxp7y"]
lines = Array[Resource]([SubResource("RoseDialogLine_mmxat")])
resource_name = "Menu 94"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_svr23"]
kind = "Answer"
text = "After hearing that story, I want to read Kirnale's Journals even more. I think I can go to the Goblin Cave on my own and bring them back. "
next_menu = 96
resource_name = "You: After hearing that story, I want to read Kirnale…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_r8fq5"]
lines = Array[Resource]([SubResource("RoseDialogLine_svr23")])
resource_name = "Menu 95"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_pmkhk"]
text = "Really? You'd be doing me a great favor if you could. According to that adventurer, he lost his bag to {fc=12}Goblin Warriors{/fc} in the {fc=2}2nd level of the Goblin Cave{/fc}."
next_menu = 97
resource_name = "NPC: Really? You'd be doing me a great favor if you c…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_31nbp"]
lines = Array[Resource]([SubResource("RoseDialogLine_pmkhk")])
resource_name = "Menu 96"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_b3ukl"]
kind = "Answer"
text = "No problem, I'll go right away."
next_menu = 98
resource_name = "You: No problem, I'll go right away."

