lines = Array[Resource]([SubResource("RoseDialogLine_0bpcj")])
resource_name = "Menu 53"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_m1rk5"]
text = "Yes, Lucid asked Kirnale to explore the monster stronghold. However, Lillith insisted on accompanying Kirnale. You know the rest of the story. Kirnale and Lillith never returned, and the other heroes eventually entered the monster stronghold and were never heard from again."
