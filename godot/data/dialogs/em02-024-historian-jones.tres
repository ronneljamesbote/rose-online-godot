text = "Oh, please don't flatter me. I’m only doing what's right."
next_menu = 105
resource_name = "You: Oh, please don't flatter me. I’m only doing what…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_3jvel"]
