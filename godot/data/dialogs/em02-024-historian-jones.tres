resource_name = "Menu 40"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_85s3t"]
text = "Lillith's Scales. She created these scales to ensure fair trade and ethical business. The moral principles and scales that all merchants and Dealers use today are all based from Lillith's original designs."
