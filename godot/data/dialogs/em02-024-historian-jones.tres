resource_name = "Menu 34"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_pdnd5"]
text = "Lillith actually played a critical role as one of the Seven Knights, and even in the establishment of the Akram Kingdom. Unfortunately, she is only remembered as the girl who fell in love with Kirnale."
