resource_name = "Menu 51"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_spogx"]
text = "Well, the monster stronghold that the Seven Knights found on their final adventure was unexplored territory. So they needed someone to scout that area before they could all enter."
