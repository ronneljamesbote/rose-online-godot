[sub_resource type="RoseDialogLine" id="RoseDialogLine_i00q1"]
text = "Don’t believe all the rumors. If you want to know the truth, you must learn the history of Junon Planet. We have had mutated monsters which started to appear as a result of the Devil Pest for a long time, but they've been tolerable. Visitors have been doing their best to defeat these monsters for a long time. But then..."
next_menu = 11
resource_name = "NPC: Don’t believe all the rumors. If you want to kno…"

