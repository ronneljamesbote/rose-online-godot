[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_pgckc"]
lines = Array[Resource]([SubResource("RoseDialogLine_bmiam")])
resource_name = "Menu 101"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_gewed"]
kind = "Answer"
text = "I restored Lucid's Sword. I want to present this to the Kingdom Museum and was hoping that you'd do that for me."
next_menu = 103
