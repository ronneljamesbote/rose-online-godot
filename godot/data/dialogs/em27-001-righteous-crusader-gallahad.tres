text = "Hmm, is that so? In any case, it's an ominous statue."
next_menu = 27
resource_name = "NPC: Hmm, is that so? In any case, it's an ominous st…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_c0vx4"]
lines = Array[Resource]([SubResource("RoseDialogLine_iqp5j")])
resource_name = "Menu 26"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_vfp17"]
kind = "Answer"
text = "So what exactly happened?"
next_menu = 28
resource_name = "You: So what exactly happened?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_8u0ek"]
lines = Array[Resource]([SubResource("RoseDialogLine_vfp17")])
resource_name = "Menu 27"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_ksvej"]
text = "It wasn't very long ago that hordes of Krawfies invaded the village, razed our homes and farms, and kidnapped our children. We were powerless before them and all we could do was hide."
next_menu = 29
resource_name = "NPC: It wasn't very long ago that hordes of Krawfies …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_6dkak"]
lines = Array[Resource]([SubResource("RoseDialogLine_ksvej")])
resource_name = "Menu 28"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_su1oi"]
kind = "Answer"
text = "That really happened?"
next_menu = 30
resource_name = "You: That really happened?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_2iuk0"]
lines = Array[Resource]([SubResource("RoseDialogLine_su1oi")])
resource_name = "Menu 29"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_idblt"]
text = "Finally, we called some outside shamanists who told us that the Kenji Stone had the power to drive away the Krawfies. They started a ceremony for this purpose, but the Krawfies still kept coming."
next_menu = 31
resource_name = "NPC: Finally, we called some outside shamanists who t…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_lvqds"]
lines = Array[Resource]([SubResource("RoseDialogLine_idblt")])
resource_name = "Menu 30"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_cjrmr"]
kind = "Answer"
text = "It looks like these shamanists were frauds…"
next_menu = 32
resource_name = "You: It looks like these shamanists were frauds…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_uhlf7"]
lines = Array[Resource]([SubResource("RoseDialogLine_cjrmr")])
resource_name = "Menu 31"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_mpe4a"]
text = "Yes, it's easy to see that now. Those shamanists took all our food and Zulie for that ceremony, but no one suspected them at the time."
next_menu = 33
resource_name = "NPC: Yes, it's easy to see that now. Those shamanists…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_uplyx"]
lines = Array[Resource]([SubResource("RoseDialogLine_mpe4a")])
resource_name = "Menu 32"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_5ev6u"]
kind = "Answer"
text = "But it didn't work. Did it?"
next_menu = 34
resource_name = "You: But it didn't work. Did it?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_hqmmk"]
lines = Array[Resource]([SubResource("RoseDialogLine_5ev6u")])
resource_name = "Menu 33"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_dvmwf"]
text = "No. Eventually, the shamanists told us that sacrifices were necessary to help us. They took our children, and beneath the Kenji Stone, they... I don't want to think about it. In the end, those shamanists committed a greater evil against us than those Krawfies ever did."
next_menu = 35
resource_name = "NPC: No. Eventually, the shamanists told us that sacr…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_3v1np"]
lines = Array[Resource]([SubResource("RoseDialogLine_dvmwf")])
resource_name = "Menu 34"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_jme8f"]
kind = "Answer"
text = "It seems that humans have the greatest capacity for both good and evil."
next_menu = 36
resource_name = "You: It seems that humans have the greatest capacity …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_g76eq"]
lines = Array[Resource]([SubResource("RoseDialogLine_jme8f")])
resource_name = "Menu 35"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_d2ape"]
text = "Yes. Then, in our darkest hour, a single warrior appeared and drove away both the Krawfies and the shamanists. In several days he ended our accursed years of oppression. He's truly the greatest warrior to grace our village."
next_menu = 37
resource_name = "NPC: Yes. Then, in our darkest hour, a single warrior…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_brr56"]
lines = Array[Resource]([SubResource("RoseDialogLine_d2ape")])
resource_name = "Menu 36"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_ustr1"]
kind = "Answer"
text = "So what was his name?"
next_menu = 38
resource_name = "You: So what was his name?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_dpw2q"]
lines = Array[Resource]([SubResource("RoseDialogLine_ustr1")])
resource_name = "Menu 37"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_rb85p"]
text = "Unfortunately, he left as quickly as he came. Although he didn't give his name, he left his dagger here in rush to leave. That is his Golden Dagger."
next_menu = 39
resource_name = "NPC: Unfortunately, he left as quickly as he came. Al…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_yint8"]
lines = Array[Resource]([SubResource("RoseDialogLine_rb85p")])
resource_name = "Menu 38"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_fvi60"]
kind = "Answer"
text = "I've heard the Golden Dagger is a symbol of the royal family, so wouldn't that mean that the Prince was this warrior?"
next_menu = 40
resource_name = "You: I've heard the Golden Dagger is a symbol of the …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_4408b"]
lines = Array[Resource]([SubResource("RoseDialogLine_fvi60")])
resource_name = "Menu 39"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_bkkls"]
text = "Are you still saying the Prince and the Great Warrior is the same person? Even if it is true, I wouldn't believe it."
next_menu = 41
resource_name = "NPC: Are you still saying the Prince and the Great Wa…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_besta"]
lines = Array[Resource]([SubResource("RoseDialogLine_bkkls")])
resource_name = "Menu 40"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_6oif7"]
kind = "Answer"
text = "Fine, then show me the Golden Dagger. Then I'll see whether or not it belonged to the royal family."
next_menu = 42
resource_name = "You: Fine, then show me the Golden Dagger. Then I'll …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_1me3e"]
lines = Array[Resource]([SubResource("RoseDialogLine_6oif7")])
resource_name = "Menu 41"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_bvrnu"]
text = "How would you know just by looking at it?"
next_menu = 43
resource_name = "NPC: How would you know just by looking at it?"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_k602c"]
lines = Array[Resource]([SubResource("RoseDialogLine_bvrnu")])
resource_name = "Menu 42"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_yh27h"]
kind = "Answer"
text = "I wouldn't. I'd find someone qualified to verify its authenticity, so let me borrow it for just a little while."
next_menu = 44
resource_name = "You: I wouldn't. I'd find someone qualified to verify…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_l8r3k"]
lines = Array[Resource]([SubResource("RoseDialogLine_yh27h")])
resource_name = "Menu 43"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_ljcsl"]
text = "I've been protecting this dagger, waiting for the day that I can return it to the great warrior. How can I just give it to you now?"
next_menu = 45
resource_name = "NPC: I've been protecting this dagger, waiting for th…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_psnlt"]
lines = Array[Resource]([SubResource("RoseDialogLine_ljcsl")])
resource_name = "Menu 44"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_02dda"]
kind = "Answer"
text = "It's only for a little while. If the great hero shows up while I'm gone, just have him sit over a cup of tea and I'll be back before he finishes."
next_menu = 46
resource_name = "You: It's only for a little while. If the great hero …"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_7safm"]
