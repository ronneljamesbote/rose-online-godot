resource_name = "Menu 29"

[sub_resource type="RoseDialogLine" id="RoseDialogLine_c4tew"]
text = "There are many things you should know about Carts, but let me first tell you about its origins. If the Mana Engine, which operates by Mana Oil, was not invented, we would not have Carts today. The Mana Engine was invented by Anthony Flight in the year 604 in the era of hearts. At first, it was inefficient and performed poorly, so people didn't pay attention to it. However, as more improvements were made to the Mana Engine, it finally became the driving force behind the Cart. That's basically how the Cart was created."
next_menu = 31
resource_name = "NPC: There are many things you should know about Cart…"

[sub_resource type="RoseDialogMenu" id="RoseDialogMenu_1jcjk"]
